<UserControl x:Class="RagnaController.ControllerVisualization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RagnaController"
             Background="Transparent"
             Width="300" Height="200"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Focusable="False">

    <UserControl.Resources>
        <!-- Controller Body -->
        <Style x:Key="ControllerBody" TargetType="Border">
            <Setter Property="Background" Value="LinearGradientBrush, StartPoint=0,0, EndPoint=145deg,#1e1e24,#16161a"/>
            <Setter Property="CornerRadius" Value="120,120,80,80"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- D-Pad Button -->
        <Style x:Key="DpadButton" TargetType="Button">
            <Setter Property="Background" Value="LinearGradientBrush, StartPoint=145deg,#3a3a45,#2a2a30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Effect" Value="{StaticResource BlueGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button (ABXY) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-4"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="Effect" Value="{StaticResource BlueGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <TranslateTransform Y="-2"/>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Touchpad -->
        <Style x:Key="Touchpad" TargetType="Border">
            <Setter Property="Background" Value="LinearGradientBrush, StartPoint=145deg,#374151,#1f2937"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Sticky Button -->
        <Style x:Key="StickyButton" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#374151" CornerRadius="50"
                                Padding="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Effect" Value="{StaticResource BlueGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start/Select Button -->
        <Style x:Key="StartSelectButton" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#6b7280" CornerRadius="12"
                                Padding="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
                                <Setter Property="Effect" Value="{StaticResource PurpleGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Individual Action Button Colors -->
        <SolidColorBrush x:Key="BtnAColor" Color="#ef4444"/>  <!-- Red -->
        <SolidColorBrush x:Key="BtnBColor" Color="#f59e0b"/>  <!-- Yellow -->
        <SolidColorBrush x:Key="BtnXColor" Color="#3b82f6"/>  <!-- Blue -->
        <SolidColorBrush x:Key="BtnYColor" Color="#a855f7"/>  <!-- Purple -->

    </UserControl.Resources>

    <Grid>
        <!-- D-Pad -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30">
            <Button Style="{StaticResource DpadButton}" Width="70" Height="70">
                <Grid>
                    <Path Data="M 35,5 L 35,65" Stroke="#8A95AC" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Grid>
            </Button>
            <StackPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource DpadButton}" Width="70" Height="70">
                    <Path Data="M 15,35 L 65,35" Stroke="#8A95AC" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Button>
                <Button Style="{StaticResource DpadButton}" Width="70" Height="70">
                    <Path Data="M 15,35 L 65,35" Stroke="#8A95AC" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Action Buttons ABXY -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="30,30">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActionButton}" Background="{StaticResource BtnAColor}">
                    <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Button>
                <Button Style="{StaticResource ActionButton}" Background="{StaticResource BtnBColor}">
                    <TextBlock Text="B" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActionButton}" Background="{StaticResource BtnXColor}">
                    <TextBlock Text="X" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Button>
                <Button Style="{StaticResource ActionButton}" Background="{StaticResource BtnYColor}">
                    <TextBlock Text="Y" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Touchpad -->
        <Border Style="{StaticResource Touchpad}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Margin="0,-20">
            <Path Data="M 10,30 L 90,30 M 50,10 L 50,50" 
                  Stroke="#8A95AC" 
                  StrokeThickness="2" 
                  StrokeLineJoin="Round"/>
        </Border>

        <!-- Sticky Buttons -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20">
            <Button Style="{StaticResource StickyButton}" Width="45" Height="45">
                <Path Data="M 15,15 L 25,25 M 25,15 L 15,25" 
                      Stroke="#FFFFFF" 
                      StrokeThickness="2" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
            <Button Style="{StaticResource StickyButton}" Width="45" Height="45">
                <Path Data="M 15,15 L 25,25 M 25,15 L 15,25" 
                      Stroke="#FFFFFF" 
                      StrokeThickness="2" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
            <Button Style="{StaticResource StickyButton}" Width="45" Height="45">
                <Path Data="M 18,15 L 22,15 M 18,18 L 18,22" 
                      Stroke="#FFFFFF" 
                      StrokeThickness="2" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- Start/Select -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20">
            <Button Style="{StaticResource StartSelectButton}" Width="50" Height="50">
                <Path Data="M 15,15 L 35,15 M 15,18 L 35,18" 
                      Stroke="#FFFFFF" 
                      StrokeThickness="2" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
            <Button Style="{StaticResource StartSelectButton}" Width="50" Height="50">
                <Path Data="M 18,15 L 22,15 M 18,18 L 18,22" 
                      Stroke="#FFFFFF" 
                      StrokeThickness="2" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
