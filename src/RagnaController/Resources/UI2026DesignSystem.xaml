<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         RAGNAROK CONTROLLER UI 2026 DESIGN SYSTEM
         Dark-Mode Palette: Anthrazit/Mattschwarz mit Ragnarok-Blau & Cyberpunk-Violett
         Glassmorphismus, abgerundete Ecken, Gaming-UI Patterns
         ============================================================ -->

    <!-- ============================================================
         COLOR PALETTE
         ============================================================ -->

    <!-- Background Colors (Deep Obsidian) -->
    <SolidColorBrush x:Key="BgPrimary" Color="#0f0f12"/>          <!-- Deepest background -->
    <SolidColorBrush x:Key="BgSecondary" Color="#1a1a20"/>        <!-- Panels, headers -->
    <SolidColorBrush x:Key="BgTertiary" Color="#25252e"/>         <!-- Cards, raised states -->
    <SolidColorBrush x:Key="BgBorder" Color="#1c1c24"/>           <!-- Hairline borders -->

    <!-- Legacy aliases for backward compatibility -->
    <SolidColorBrush x:Key="BgPanel" Color="#1a1a20"/>
    <SolidColorBrush x:Key="BgCard" Color="#25252e"/>
    <SolidColorBrush x:Key="BgRaised" Color="#2a2a35"/>
    <SolidColorBrush x:Key="BorderHair" Color="#1c1c24"/>
    <SolidColorBrush x:Key="BorderGlow" Color="#2a2a35"/>

    <!-- Accent Colors (Ragnarok Blue & Cyberpunk Purple) -->
    <SolidColorBrush x:Key="AccentBlue" Color="#3b82f6"/>         <!-- Ragnarok Blue - primary action -->
    <SolidColorBrush x:Key="AccentPurple" Color="#8b5cf6"/>       <!-- Cyberpunk Purple - secondary action -->
    <SolidColorBrush x:Key="AccentBlueDim" Color="#2a5cdb"/>      <!-- Dimmed blue -->
    <SolidColorBrush x:Key="AccentPurpleDim" Color="#7c3aed"/>    <!-- Dimmed purple -->

    <!-- Additional Accents (for compatibility with existing code) -->
    <SolidColorBrush x:Key="Live" Color="#39FF8C"/>               <!-- Success green -->
    <SolidColorBrush x:Key="Signal" Color="#8b5cf6"/>             <!-- Signal purple (alias for AccentPurple) -->
    <SolidColorBrush x:Key="Gold" Color="#c9a646"/>               <!-- Gold accent -->
    <SolidColorBrush x:Key="GoldDim" Color="#b8963e"/>            <!-- Dimmed gold -->
    <SolidColorBrush x:Key="Danger" Color="#FF5252"/>             <!-- Danger red -->

    <!-- Glow Colors (for compatibility) -->
    <SolidColorBrush x:Key="BlueGlowColor" Color="#3b82f6"/>
    <SolidColorBrush x:Key="PurpleGlowColor" Color="#8b5cf6"/>
    <SolidColorBrush x:Key="LiveGlowColor" Color="#39FF8C"/>
    <SolidColorBrush x:Key="GoldGlowColor" Color="#c9a646"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#f4f4f5"/>        <!-- Primary text -->
    <SolidColorBrush x:Key="TextSecondary" Color="#a1a1aa"/>      <!-- Secondary/muted text -->
    <SolidColorBrush x:Key="TextTertiary" Color="#71717a"/>       <!-- Disabled text -->
    <SolidColorBrush x:Key="TextHi" Color="#f4f4f5"/>             <!-- Legacy alias -->
    <SolidColorBrush x:Key="TextMid" Color="#a1a1aa"/>            <!-- Legacy alias -->
    <SolidColorBrush x:Key="TextDim" Color="#71717a"/>            <!-- Legacy alias -->
    <SolidColorBrush x:Key="TextLow" Color="#71717a"/>            <!-- Legacy alias -->

    <!-- Glassmorphism Colors -->
    <Color x:Key="GlassBgColor">#3A3A45</Color>                   <!-- Base glass background -->
    <Color x:Key="GlassBorderColor">#2A2A35</Color>               <!-- Glass border -->

    <!-- Glow Effects -->
    <Color x:Key="GlowBlue">#3b82f6</Color>                        <!-- Blue glow color -->
    <Color x:Key="GlowPurple">#8b5cf6</Color>                     <!-- Purple glow color -->

    <!-- ============================================================
         GRADIENTS
         ============================================================ -->

    <!-- Main Window Gradient (Deep to lighter) -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0f0f12" Offset="0"/>
        <GradientStop Color="#1a1a20" Offset="0.5"/>
        <GradientStop Color="#25252e" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass Panel Gradient -->
    <LinearGradientBrush x:Key="GlassPanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3A45" Offset="0"/>              <!-- 78% opacity -->
        <GradientStop Color="#2A2A35" Offset="1"/>               <!-- 60% opacity -->
    </LinearGradientBrush>

    <!-- Hover/Raised State Gradient -->
    <LinearGradientBrush x:Key="RaisedStateGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4A55" Offset="0"/>               <!-- 85% opacity -->
        <GradientStop Color="#3A3A45" Offset="1"/>               <!-- 70% opacity -->
    </LinearGradientBrush>

    <!-- ============================================================
         SHADOWS & GLOWS
         ============================================================ -->

    <!-- Card Shadow (Subtle depth) -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.35" Direction="270"/>

    <!-- Medium Shadow (Elevated dropdowns, cards) -->
    <DropShadowEffect x:Key="ShadowMedium" Color="#000000" BlurRadius="40" ShadowDepth="4" Opacity="0.4"/>

    <!-- Blue Glow Effect (Active elements) -->
    <DropShadowEffect x:Key="BlueGlow" Color="#3b82f6" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>

    <!-- Purple Glow Effect (Secondary actions) -->
    <DropShadowEffect x:Key="PurpleGlow" Color="#8b5cf6" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>

    <!-- Inner Glow (Pressed state) -->
    <DropShadowEffect x:Key="InnerGlow" Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>

    <!-- Gold Glow (Highlight/Selection) -->
    <DropShadowEffect x:Key="GoldGlow" Color="#c9a646" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>

    <!-- ============================================================
         CORNER RADIUS
         ============================================================ -->

    <CornerRadius x:Key="RadiusSm">8</CornerRadius>              <!-- Small (buttons, inputs) -->
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>             <!-- Medium (cards, panels) -->
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>             <!-- Large (main containers) -->
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>             <!-- Extra large (windows) -->
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>          <!-- Full circle -->

    <!-- ============================================================
         GLASS PANEL STYLE
         ============================================================ -->

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassPanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Compact Glass Panel (for inline use) -->
    <Style x:Key="GlassPanelCompact" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ============================================================
         TYPOGRAPHY
         ============================================================ -->

    <!-- Eyebrow / Section Header -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Body Text -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <!-- Secondary Text -->
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Stat Value -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- Stat Label -->
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- Brand Wordmark -->
    <Style x:Key="BrandWordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- ============================================================
         BUTTON STYLES
         ============================================================ -->

    <!-- Primary Button (Ragnarok Blue) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource BlueGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="bd" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#4fc3ff" Duration="0:0:0.15"/>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="bd" 
                                                                   Storyboard.TargetProperty="Effect" Duration="0:0:0.15">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BlueGlow}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="bd" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="{StaticResource AccentBlue}" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPurple}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource PurpleGlow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button (Cyberpunk Purple) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource PurpleGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="bd" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#a78bfa" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource BlueGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost Button (Subtle, for toolbars) -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="bd" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#3A3A45" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#4A4A55"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Button (Square, for chrome/actions) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="#FF5252"/>
        <Setter Property="BorderBrush" Value="#FF5252"/>
    </Style>

    <!-- Tab Button (Underline style) -->
    <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Tab Button Active -->
    <Style x:Key="TabButtonActive" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="1,0"/>
    </Style>

    <!-- ============================================================
         INPUT CONTROLS
         ============================================================ -->

    <!-- TextBox: Blue focus glow -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bg" Background="{StaticResource BgSecondary}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            <Setter TargetName="bg" Property="Effect" Value="{StaticResource BlueGlow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark ComboBox - THE canonical style for all windows -->
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}" 
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            CornerRadius="{StaticResource RadiusSm}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" 
                                                  Stroke="{StaticResource TextSecondary}"
                                                  StrokeThickness="1.4" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueDim}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource BgTertiary}" 
                                    BorderBrush="{StaticResource BgBorder}"
                                    BorderThickness="1" 
                                    CornerRadius="{StaticResource RadiusSm}" 
                                    Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" 
                                    Effect="{StaticResource CardShadow}">
                                <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource AccentBlueDim}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            <Setter TargetName="Toggle" Property="Effect" Value="{StaticResource BlueGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="Transparent" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A35"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3A3A45"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: Blue track, glowing thumb -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" Background="#2A2A35" CornerRadius="2" Margin="5,0"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Background="{StaticResource AccentBlue}" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="2" Height="4" 
                                                    VerticalAlignment="Center" 
                                                    Effect="{StaticResource BlueGlow}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="thumb" Cursor="Hand">
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{StaticResource AccentPurple}"/>
                            <Setter TargetName="thumb" Property="Effect" Value="{StaticResource PurpleGlow}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="thumb" Property="Background" Value="{StaticResource AccentBlue}"/>
                            <Setter TargetName="thumb" Property="Effect" Value="{StaticResource BlueGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         CHECKBOX & TOGGLE SWITCH
         ============================================================ -->

    <!-- Toggle Switch -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="border" Background="#2A2A35" 
                                BorderBrush="{StaticResource BgBorder}" 
                                BorderThickness="1" 
                                CornerRadius="6"
                                Width="40" Height="20"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="toggle" Width="16" Height="16" 
                                     Fill="#1A1A20" Margin="2,2"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="48,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3A3A45"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="toggle" Property="Fill" Value="{StaticResource AccentBlue}"/>
                            <Setter TargetName="toggle" Property="Effect" Value="{StaticResource BlueGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
