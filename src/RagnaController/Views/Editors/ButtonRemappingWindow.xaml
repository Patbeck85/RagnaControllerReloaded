<!-- 
    WPF window definition.
-->
<Window x:Class="RagnaController.Views.Editors.ButtonRemappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="{core:Loc ButtonRemap_Header}" Width="1200" Height="850"
        MinWidth="900" MinHeight="640"
        Background="Transparent" Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary><Style x:Key="LayerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="13"/><Setter Property="MinWidth" Value="72"/></Style>
            <Style x:Key="LayerButtonActive" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="13"/><Setter Property="MinWidth" Value="72"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource Radius2Xl}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#x1F3AE;" Foreground="{StaticResource Gold}" Margin="0,0,10,0" FontSize="18" Effect="{StaticResource NeonGlow}"/><TextBlock Text="{core:Loc ButtonRemap_Header}" Style="{StaticResource BrandWordmark}" FontSize="14"/></StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnCancel_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="{core:Loc CLOSE_WINDOW}" AutomationProperties.Name="{core:Loc CLOSE_WINDOW}"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="480"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="25">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{core:Loc UI.CONTROLLER_PREVIEW}" Style="{StaticResource Eyebrow}" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"><ContentControl x:Name="PreviewContainer"/></Viewbox>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="20" Margin="12,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="{core:Loc SELECT_LAYER}" Style="{StaticResource Eyebrow}" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{core:Loc ButtonRemapping_SelectLayerTooltip}" Foreground="{StaticResource Gold}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <UniformGrid Columns="5" HorizontalAlignment="Stretch" Rows="1">
                                <Button x:Name="BtnLayerBase" Content="BASE" Click="LayerBtn_Click" Style="{StaticResource LayerButtonActive}" Tag=""/>
                                <Button x:Name="BtnLayerL1" Content="L1+" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="L1+"/>
                                <Button x:Name="BtnLayerR1" Content="R1+" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="R1+"/>
                                <Button x:Name="BtnLayerL2" Content="L2+" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="L2+"/>
                                <Button x:Name="BtnLayerR2" Content="R2+" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="R2+"/>
                            </UniformGrid>
                            <Rectangle Height="1" Fill="{StaticResource BgBorder}" Margin="0,20,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                            <StackPanel>
                                <!-- D-Pad -->
                                <Border Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{core:Loc UI.D-Pad}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <Button Content="&#x21BA;" Click="ResetBtn_Click" Padding="0" Style="{StaticResource GhostButton}" FontSize="12" Cursor="Hand" ToolTip="Reset D-Pad to default" AutomationProperties.Name="Reset D-Pad to default" MinWidth="32" MinHeight="32" HorizontalAlignment="Right"/>
                                        <Slider x:Name="SldDpad" Minimum="-100" Maximum="100" Value="0" ValueChanged="DpadSlider_ValueChanged" VerticalAlignment="Center" Style="{StaticResource GlassSlider}" Margin="0,0,10,0" AutomationProperties.Name="D-Pad slider"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtDpadValue" Text="0.00" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Left Stick -->
                                <Border Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{core:Loc UI.Left_Stick}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <Button Content="&#x21BA;" Click="ResetBtn_Click" Padding="0" Style="{StaticResource GhostButton}" FontSize="12" Cursor="Hand" ToolTip="Reset Left Stick to default" AutomationProperties.Name="Reset Left Stick to default" MinWidth="32" MinHeight="32" HorizontalAlignment="Right"/>
                                        <Slider x:Name="SldLStick" Minimum="-100" Maximum="100" Value="0" ValueChanged="LStickSlider_ValueChanged" VerticalAlignment="Center" Style="{StaticResource GlassSlider}" Margin="0,0,10,0" AutomationProperties.Name="Left stick slider"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtLStickValue" Text="0.00" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Right Stick -->
                                <Border Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{core:Loc UI.Right_Stick}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <Button Content="&#x21BA;" Click="ResetBtn_Click" Padding="0" Style="{StaticResource GhostButton}" FontSize="12" Cursor="Hand" ToolTip="Reset Right Stick to default" AutomationProperties.Name="Reset Right Stick to default" MinWidth="32" MinHeight="32" HorizontalAlignment="Right"/>
                                        <Slider x:Name="SldRStick" Minimum="-100" Maximum="100" Value="0" ValueChanged="RStickSlider_ValueChanged" VerticalAlignment="Center" Style="{StaticResource GlassSlider}" Margin="0,0,10,0" AutomationProperties.Name="Right stick slider"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtRStickValue" Text="0.00" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- L1/R1 -->
                                <Border Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{core:Loc ButtonRemapping_L1R1Label}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <Button Content="&#x21BA;" Click="ResetBtn_Click" Padding="0" Style="{StaticResource GhostButton}" FontSize="12" Cursor="Hand" ToolTip="Reset L1/R1 to default" AutomationProperties.Name="Reset L1/R1 to default" MinWidth="32" MinHeight="32" HorizontalAlignment="Right"/>
                                        <Slider x:Name="SldL1R1" Minimum="-100" Maximum="100" Value="0" ValueChanged="L1R1Slider_ValueChanged" VerticalAlignment="Center" Style="{StaticResource GlassSlider}" Margin="0,0,10,0" AutomationProperties.Name="L1/R1 slider"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtL1R1Value" Text="0.00" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- L2/R2 -->
                                <Border Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{core:Loc ButtonRemapping_L2R2Label}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <Button Content="&#x21BA;" Click="ResetBtn_Click" Padding="0" Style="{StaticResource GhostButton}" FontSize="12" Cursor="Hand" ToolTip="Reset L2/R2 to default" AutomationProperties.Name="Reset L2/R2 to default" MinWidth="32" MinHeight="32" HorizontalAlignment="Right"/>
                                        <Slider x:Name="SldL2R2" Minimum="-100" Maximum="100" Value="0" ValueChanged="L2R2Slider_ValueChanged" VerticalAlignment="Center" Style="{StaticResource GlassSlider}" Margin="0,0,10,0" AutomationProperties.Name="L2/R2 slider"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtL2R2Value" Text="0.00" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" FontFamily="JetBrains Mono, Consolas" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Ground Spell & Self Cast Toggles -->
                                <Border Style="{StaticResource GlassPanel}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{core:Loc UI.Spell_Toggles}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <CheckBox x:Name="ChkGroundSpell" Content="Ground Spell (Aim with R-Stick)" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,15,0" Checked="SpellCheckbox_Changed" Unchecked="SpellCheckbox_Changed" Padding="8,6" Style="{StaticResource GlassPanelCompact}" Background="Transparent" BorderBrush="{StaticResource BgBorder}" BorderThickness="1"/>
                                            <CheckBox x:Name="ChkSelfCast" Content="Self-Cast (Snap to Center)" Foreground="{StaticResource Gold}" FontSize="13" FontWeight="SemiBold" Margin="0,0,15,0" Checked="SpellCheckbox_Changed" Unchecked="SpellCheckbox_Changed" Padding="8,6" Style="{StaticResource GlassPanelCompact}" Background="Transparent" BorderBrush="{StaticResource BgBorder}" BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <!-- TASK-2011: Profile Load/Save section -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                        <TextBlock Text="{core:Loc ButtonRemapping_ProfileManagement}" Style="{StaticResource Eyebrow}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                        <ComboBox x:Name="ProfileCombo" Style="{StaticResource DarkComboBox}" Height="44" FontSize="14" FontFamily="Segoe UI Variable, Segoe UI" AutomationProperties.Name="Profile selector" SelectionChanged="ProfileCombo_SelectionChanged">
                                            <ComboBox.ToolTip>
                                                <ToolTip Content="Select an existing profile to edit its button mappings" Foreground="{StaticResource Gold}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                                            </ComboBox.ToolTip>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button x:Name="BtnLoadProfile" Content="{core:Loc ProfileLibrary_LoadBtn}" Click="BtnLoadProfile_Click" Style="{StaticResource GhostButton}" Height="40" Width="120" FontSize="12" AutomationProperties.Name="Load selected profile"/>
                                            <Button x:Name="BtnSaveAsProfile" Content="{core:Loc ButtonRemapping_SaveAsProfile}" Click="BtnSaveAsProfile_Click" Style="{StaticResource PrimaryButton}" Height="40" Width="100" FontSize="12" Margin="10,0,0,0" AutomationProperties.Name="Save profile as new"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Profile Info -->
                                    <Border Grid.Row="1" Style="{StaticResource GlassPanelCompact}" Padding="16" CornerRadius="{StaticResource RadiusMd}">
                                        <StackPanel>
                                            <TextBlock x:Name="ProfileInfoName" Text="{core:Loc ProfileLibrary_NoProfilesTitle}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="ProfileInfoClass" Text="{core:Loc UI.Class_Dash}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="ProfileInfoDeadzone" Text="{core:Loc UI.Deadzone_Dash}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="ProfileInfoCursorDeadzone" Text="{core:Loc ButtonRemapping_CursorDeadzone}" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hint -->
                                    <TextBlock Grid.Row="2" Text="{core:Loc ButtonRemapping_Hint}" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </Grid>
                            </Border>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource Radius2Xl},{StaticResource Radius2Xl}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="{core:Loc UI.SAVE_AND_CLOSE}" Style="{StaticResource PrimaryButton}" Width="180" Height="48" Margin="0,0,15,0" Click="BtnSave_Click" ToolTip="Save settings and close window"/>
                    <Button Content="{core:Loc Common.Cancel}" Style="{StaticResource GhostButton}" Width="130" Height="48" Click="BtnCancel_Click" ToolTip="Discard changes and close window"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>