<!-- 
    WPF window definition.
-->
<Window x:Class="RagnaController.Views.Editors.ComboEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="{core:Loc ComboEditor_Title}" Width="780" Height="720"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource Radius2Xl}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" Foreground="{StaticResource Gold}" Margin="0,0,10,0" FontSize="18" Effect="{StaticResource NeonGlow}"/>
                        <TextBlock Text="COMBO ENGINE EDITOR" Style="{StaticResource BrandWordmark}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkEnabled" Content="{core:Loc ComboEditor_EnableCheck}" Foreground="{StaticResource Green}" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center" Padding="8,6" FontFamily="Segoe UI Variable, Segoe UI"/>
                        <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="{core:Loc CLOSE_COMBO_EDITOR_WINDOW}" AutomationProperties.Name="{core:Loc CLOSE_COMBO_EDITOR_WINDOW}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource GlassPanelCompact}" Margin="16,12,16,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="{core:Loc ComboEditor_SelectClassTemplate}" Style="{StaticResource Eyebrow}" Margin="0,0,0,12">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{core:Loc ComboEditor_ClassCardsTooltip}" Foreground="{StaticResource Gold}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                    <WrapPanel x:Name="ClassCards" AutomationProperties.Name="Class card selector"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Margin="16,12" Padding="15">
                <TextBlock x:Name="HintText" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"/>
            </Border>
            <Border Grid.Row="3" Margin="16,0,16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="DELAYS (" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.ToolTip>
                                <ToolTip Content="Adjust delays between combo steps for precise timing" Foreground="{StaticResource Gold}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button x:Name="BtnTabPre" Content="{core:Loc ComboEditor_PreRenewalBtn}" Click="BtnTabPre_Click" Height="44" Padding="20,0" Style="{StaticResource PrimaryButton}" FontSize="12" AutomationProperties.Name="Pre-renewal tab"/>
                        <Button x:Name="BtnTabRen" Content="{core:Loc ComboEditor_RenewalBtn}" Click="BtnTabRen_Click" Height="44" Padding="20,0" Style="{StaticResource GhostButton}" FontSize="12" Margin="8,0,0,0" AutomationProperties.Name="Renewal tab"/>
                        <TextBlock Text=")" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChainPanel" AutomationProperties.Name="Combo chain steps"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
                                            <Button Content="{core:Loc ComboEditor_AddStepTooltip}" Click="BtnAdd_Click" Style="{StaticResource GhostButton}" Height="44" Padding="20,0" Margin="0,0,8,0" AutomationProperties.Name="Add combo step">
                                                <Button.ToolTip>
                                                    <ToolTip Content="Add a new step to the combo sequence" Foreground="{StaticResource TextPrimary}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                                                </Button.ToolTip>
                                            </Button>
                                            <Button Content="− Remove Last" Click="BtnRemove_Click" Style="{StaticResource DangerButton}" Height="44" Padding="20,0" Margin="0,0,8,0" AutomationProperties.Name="Remove combo step">
                                                <Button.ToolTip>
                                                    <ToolTip Content="Remove the last step from the combo" Foreground="{StaticResource Danger}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                                                </Button.ToolTip>
                                            </Button>
                                            <!-- TASK-2010: Copy/Paste -->
                                            <Button Content="{core:Loc ComboEditor_CopyTooltip}" Click="BtnCopyStep_Click" Style="{StaticResource GhostButton}" Height="44" Padding="20,0" Margin="0,0,8,0" AutomationProperties.Name="Copy combo step">
                                                <Button.ToolTip>
                                                    <ToolTip Content="Copy the currently selected step to clipboard" Foreground="{StaticResource TextPrimary}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                                                </Button.ToolTip>
                                            </Button>
                                            <Button Content="{core:Loc ComboEditor_PasteTooltip}" Click="BtnPasteStep_Click" Style="{StaticResource GhostButton}" Height="44" Padding="20,0" Margin="0,0,8,0" AutomationProperties.Name="Paste combo step">
                                                <Button.ToolTip>
                                                    <ToolTip Content="Paste copied step into the combo sequence" Foreground="{StaticResource TextPrimary}" FontSize="11" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}"/>
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource Radius2Xl},{StaticResource Radius2Xl}" Padding="20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- TASK-2010: Combo Preview -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{core:Loc ComboEditor_PreviewLabel}" Style="{StaticResource Eyebrow}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewText" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{core:Loc ComboEditor_TriggerHint}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Button Content="{core:Loc ComboEditor_SaveComboBtn}" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Width="160" Height="44" Margin="0,0,10,0" ToolTip="Save settings and close window" AutomationProperties.Name="Save combo"/>
                                    <Button Content="{core:Loc ComboEditor_CancelBtn}" Click="BtnClose_Click" Style="{StaticResource GhostButton}" Width="100" Height="44" ToolTip="Discard changes and close window" AutomationProperties.Name="Close combo editor"/>
                                </StackPanel>
                            </Grid>
                        </Border>
        </Grid>
    </Border>
</Window>