<!--
    Monster Import Window.
    Lädt die vollständige Rathena Monster-Datenbank (Pre-Renewal + Renewal) von GitHub.
-->
<Window x:Class="RagnaController.Views.Windows.MonsterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="Monster Import" Width="520" Height="420"
        MinWidth="480" MinHeight="380" ResizeMode="CanResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Topmost="False">

    <Border CornerRadius="{StaticResource RadiusXl}" BorderThickness="1" BorderBrush="{StaticResource BgBorder}">
        <Border.Background>
            <RadialGradientBrush Center="0.18,0" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#0f0f12" Offset="0"/>
                <GradientStop Color="#1a1a20" Offset="0.55"/>
                <GradientStop Color="#0f0f12" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Border CornerRadius="{StaticResource RadiusXl}" ClipToBounds="True">
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="22" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,10,0"/>
                    <TextBlock Text="{core:Loc MonsterImportWindow_Header}" Style="{StaticResource BrandWordmark}"/>
                </StackPanel>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MainContentPanel" Margin="0,16,0,0">

                        <!-- Beschreibung -->
                        <Border Style="{StaticResource GlassPanelCompact}" Padding="14" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{core:Loc MonsterImportWindow_Description}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                <TextBlock Text="{core:Loc MonsterImportWindow_DescriptionText}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxHeight="80"/>
                            </StackPanel>
                        </Border>

                        <!-- Import-Sektion -->
                        <Border Style="{StaticResource GlassPanelCompact}" Padding="14" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{core:Loc MonsterImportWindow_Import}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="BtnImportFromRathena" Content="{core:Loc MonsterImportWindow_ImportFromRathena}" 
                                            Click="BtnImportFromRathena_Click" Style="{StaticResource ConsolePrimaryBtn}" Margin="0,0,8,0" Width="200" Height="36"/>
                                    <Button x:Name="BtnCancel" Content="{core:Loc MonsterImportWindow_Cancel}" 
                                            Click="BtnCancel_Click" Style="{StaticResource ConsoleGhostBtn}" Width="100" Height="36"/>
                                </StackPanel>
                                
                                <!-- Fortschritt -->
                                <ProgressBar x:Name="ProgressImport" Height="8" Margin="0,12,0,0" Visibility="Collapsed"
                                             Maximum="100" Value="0"/>
                                <TextBlock x:Name="TxtImportStatus" Style="{StaticResource TextTertiary}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtImportResult" Style="{StaticResource TextPrimary}" Margin="0,8,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Monster-DB Stats -->
                        <Border x:Name="StatsPanel" Style="{StaticResource GlassPanelCompact}" Padding="14" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{core:Loc MonsterImportWindow_DatabaseStats}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{core:Loc MonsterImportWindow_TotalMonsters}" Style="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtTotalCount" Style="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{core:Loc MonsterImportWindow_MvpCount}" Style="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtMvpCount" Style="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{core:Loc MonsterImportWindow_GameMode}" Style="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtGameMode" Style="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Fehler -->
                        <Border x:Name="ErrorPanel" Style="{StaticResource GlassPanelCompact}" Padding="14" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16" Visibility="Collapsed"
                                BorderBrush="{StaticResource AccentRed}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource AccentRed}"/>
                                <TextBlock x:Name="TxtError" Style="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtFooter" Style="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{core:Loc MonsterImportWindow_Close}" 
                                Click="BtnClose_Click" Style="{StaticResource ConsoleGhostBtn}" Width="100" Height="32" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
