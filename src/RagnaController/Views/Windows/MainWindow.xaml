<!-- 
    Main application window with tab navigation and status display.
    Hosts the main UI layout, engine status indicators, and window switching controls.
-->
<Window x:Class="RagnaController.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RagnaController"
        xmlns:views="clr-namespace:RagnaController.Views.Windows"
        xmlns:ctrl="clr-namespace:RagnaController.Controls"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:core="clr-namespace:RagnaController.Core"
        mc:Ignorable="d"
        Title="RagnaController" Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <local:ClassToIconConverter x:Key="ClassToIconConverter"/>
        <DataTemplate x:Key="ClientTabTemplate" DataType="{x:Type views:ClientTabItem}">
            <StackPanel Orientation="Horizontal" Margin="4,0">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,8,0" Effect="{StaticResource GoldGlow}"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding ProfileName}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="8,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    

    <!-- ROOT with radial depth gradient + glassmorphism -->
    <Border CornerRadius="{StaticResource RadiusXl}" BorderThickness="1" BorderBrush="{StaticResource BgBorder}">
        <Border.Background>
            <RadialGradientBrush Center="0.18,0" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#0f0f12" Offset="0"/>
                <GradientStop Color="#1a1a20" Offset="0.55"/>
                <GradientStop Color="#0f0f12" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Border CornerRadius="{StaticResource RadiusXl}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar (Modern Header) -->
                                                <Grid x:Name="TopBar" Grid.Row="0" Height="56" Background="Transparent" Margin="16,12,16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>      <!-- 0: Brand + Status -->
                                                        <ColumnDefinition Width="Auto"/>      <!-- 1: Client Tabs -->
                                                        <ColumnDefinition Width="Auto"/>      <!-- 2: Layer Tabs -->
                                                        <ColumnDefinition Width="*"/>         <!-- 3: Right panel (spacer) -->
                                                        <ColumnDefinition Width="Auto"/>      <!-- 4: Profile/Client/Window controls -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Brand + Status -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="4" Height="28" Background="{StaticResource AccentBlue}" Effect="{StaticResource BlueGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                                                        <TextBlock Text="RAGNACONTROLLER" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                                                        <Border Style="{StaticResource GlassPanel}" Margin="16,0,0,0" Padding="10,4" CornerRadius="{StaticResource RadiusSm}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8" Height="8" Fill="{StaticResource LiveColor}" VerticalAlignment="Center" Margin="0,0,6,0" Effect="{StaticResource GoldGlow}"/>
                                                                <TextBlock Text="SYSTEM ONLINE" Foreground="{StaticResource LiveColor}" FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Client Tabs (Multi-Client) -->
                                                    <Border Grid.Column="1" Style="{StaticResource GlassPanel}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4" CornerRadius="{StaticResource RadiusLg}" Margin="12,0,12,0">
                                                        <TabControl x:Name="ClientTabControl" 
                                                                    ItemTemplate="{StaticResource ClientTabTemplate}"
                                                                    SelectionChanged="ClientTabControl_SelectionChanged"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="0" Margin="0"
                                                                    AutomationProperties.Name="Client tabs">
                                                            <TabControl.ItemContainerStyle>
                                                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="TabItem">
                                                                                <Border x:Name="TabBorder" Background="Transparent" CornerRadius="{StaticResource RadiusMd}" Padding="12,6" Margin="2">
                                                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBlueDim}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgTertiary}"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </TabControl.ItemContainerStyle>
                                                        </TabControl>
                                                    </Border>

                                                    <!-- Center: Layer Tab Navigation (Modern Pill Style) -->
                                                    <Border Grid.Column="2" Style="{StaticResource GlassPanel}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4" CornerRadius="{StaticResource RadiusLg}" Margin="0,0,0,0" x:Name="LayerTabNavigationBorder">
                                                            <StackPanel x:Name="TabNavigation" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Button x:Name="TabBtnBase" Content="Base" Style="{StaticResource TabButton}" Click="TabBase_Click" Tag="Base" AutomationProperties.Name="Base tab"/>
                                                                <Button x:Name="TabBtnL1" Content="L1+" Style="{StaticResource TabButton}" Click="TabL1_Click" Tag="L1+" AutomationProperties.Name="L1+ tab"/>
                                                                <Button x:Name="TabBtnR1" Content="R1+" Style="{StaticResource TabButton}" Click="TabR1_Click" Tag="R1+" AutomationProperties.Name="R1+ tab"/>
                                                                <Button x:Name="TabBtnL2" Content="L2+" Style="{StaticResource TabButton}" Click="TabL2_Click" Tag="L2+" AutomationProperties.Name="L2+ tab"/>
                                                                <Button x:Name="TabBtnR2" Content="R2+" Style="{StaticResource TabButton}" Click="TabR2_Click" Tag="R2+" AutomationProperties.Name="R2+ tab"/>
                                                                <Button x:Name="TabBtnHealth" Content="Health" Style="{StaticResource TabButton}" Click="TabHealth_Click" Tag="Health" AutomationProperties.Name="Health tab"/>
                                                                <Button x:Name="TabBtnTelemetry" Content="Telemetry" Style="{StaticResource TabButton}" Click="TabTelemetry_Click" Tag="Telemetry" AutomationProperties.Name="Telemetry tab"/>
                                                            </StackPanel>
                                                        </Border>

                    <!-- Right: Profile Selector + Client Switcher + Window Controls -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border x:Name="ProfileSelectorBorder" Style="{StaticResource GlassPanel}" Padding="0,0,8,0" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ProfileCombo" Width="200" Style="{StaticResource DarkComboBox}" SelectionChanged="ProfileCombo_SelectionChanged" ToolTip="{core:Loc MainWindow_ProfileCombo_Tooltip}" AutomationProperties.Name="Profile selector" Grid.Column="0" Margin="8,4,0,4" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource AccentBlue}" CornerRadius="0,{StaticResource RadiusMd},{StaticResource RadiusMd},0" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right" Effect="{StaticResource BlueGlow}">
                                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="ClientSelectorBorder" Style="{StaticResource GlassPanel}" Padding="0,0,8,0" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Client:" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource TextTertiary}" FontSize="10"/>
                                                    <ComboBox x:Name="ClientCombo" Width="140" Style="{StaticResource DarkComboBox}" SelectionChanged="ClientCombo_SelectionChanged" ToolTip="Select RO client window for input routing" AutomationProperties.Name="RO client selector" Grid.Column="1" Margin="4,4,4,4" VerticalAlignment="Center"/>
                                                    <Button x:Name="BtnRefreshClients" Content="&#xE72C;" Width="28" Height="28" Style="{StaticResource WindowControlButton}" Click="BtnRefreshClients_Click" ToolTip="Refresh client list" AutomationProperties.Name="Refresh clients" Grid.Column="2" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="PresetSelectorBorder" Style="{StaticResource GlassPanel}" Padding="0,0,8,0" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Preset:" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource TextTertiary}" FontSize="10"/>
                                                    <ComboBox x:Name="PresetCombo" Width="140" Style="{StaticResource DarkComboBox}" SelectionChanged="PresetCombo_SelectionChanged" ToolTip="Select saved profile preset for quick switch" AutomationProperties.Name="Profile preset selector" Grid.Column="1" Margin="4,4,4,4" VerticalAlignment="Center"/>
                                                    <Button x:Name="BtnSavePreset" Content="&#xE74E;" Width="28" Height="28" Style="{StaticResource WindowControlButton}" Click="BtnSavePreset_Click" ToolTip="Save current profile as preset" AutomationProperties.Name="Save preset" Grid.Column="2" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="CharacterClassSelectorBorder" Style="{StaticResource GlassPanel}" Padding="0,0,8,0" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Class:" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource TextTertiary}" FontSize="10"/>
                                                    <ComboBox x:Name="ClassCharacterCombo" Width="130" Style="{StaticResource DarkComboBox}" SelectionChanged="ClassCharacterCombo_SelectionChanged" ToolTip="Select character class for quick profile load" AutomationProperties.Name="Character class selector" Grid.Column="1" Margin="4,4,4,4" VerticalAlignment="Center">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                                                    <Image Source="{Binding Class, Converter={StaticResource ClassToIconConverter}}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Class}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button x:Name="BtnRefreshClasses" Content="&#xE72C;" Width="28" Height="28" Style="{StaticResource WindowControlButton}" Click="BtnRefreshClasses_Click" ToolTip="Refresh class list" AutomationProperties.Name="Refresh classes" Grid.Column="2" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- Profile Validation -->
                                            <Button x:Name="BtnProfileValidation" Content="&#xE716; Profil validieren" Style="{StaticResource GhostButton}" Click="BtnProfileValidation_Click" ToolTip="Öffnet die Profil-Validierung (Schema-Migration und Integritäts-Check)" AutomationProperties.Name="Profile validation" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <!-- Monster Import -->
                                            <Button x:Name="BtnMonsterImport" Content="&#xE77A; Monster DB Import" Style="{StaticResource GhostButton}" Click="BtnMonsterImport_Click" ToolTip="Importiert die vollständige Rathena Monster-Datenbank (Pre-Renewal und Renewal)" AutomationProperties.Name="Monster DB Import" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <!-- Renewal / Pre-Renewal Toggle -->
                                            <Border x:Name="RenewalModeBorder" Style="{StaticResource GlassPanelCompact}" Padding="8,4" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="ChkRenewalMode" Content="Renewal" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource ToggleSwitch}" ToolTip="Renewal-Modus aktivieren (Deaktiviert = Pre-Renewal)" AutomationProperties.Name="Renewal Mode Toggle" Checked="ChkRenewalMode_Checked" Unchecked="ChkRenewalMode_Unchecked"/>
                                                    <TextBlock x:Name="RenewalModeLabel" Text="Pre-Renewal" Foreground="{StaticResource AccentGold}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Renewal mode label"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnMinimize" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" Width="36" Height="36"/>
                                                <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="BtnMaximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize" Width="36" Height="36"/>
                                                <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource WindowControlButtonClose}" Click="BtnClose_Click" ToolTip="Close" AutomationProperties.Name="Close" Width="36" Height="36"/>
                                                <Button x:Name="BtnBigPicture" Content="🎮" Style="{StaticResource WindowControlButton}" Click="BtnBigPicture_Click" ToolTip="Big Picture Mode (Steam Deck)" AutomationProperties.Name="Big Picture Mode" Width="36" Height="36" FontSize="16"/>
                                            </StackPanel>
                                        </StackPanel>
                </Grid>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Controller Visualization + Quick Actions -->
                    <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Margin="0,0,8,0" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Controller Visualization Header -->
                            <TextBlock Grid.Row="0" Text="CONTROLLER" Style="{StaticResource Eyebrow}" Margin="16,16,16,8"/>

                            <!-- Controller SVG Canvas with Interactive Layout -->
                            <Border Grid.Row="1" Margin="16,0,16,8" Background="{StaticResource BgPanel}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1">
                                <Viewbox Stretch="Uniform" Margin="16">
                                    <Canvas Width="400" Height="280">
                                        <!-- Controller Body Outline -->
                                        <Path Data="M20,140 C20,60 60,20 140,20 L260,20 C340,20 380,60 380,140 L380,220 C380,260 340,280 260,280 L140,280 C60,280 20,260 20,220 Z" 
                                              Stroke="{StaticResource AccentBlue}" StrokeThickness="2" Fill="{StaticResource BgSecondary}" Opacity="0.4" Effect="{StaticResource BlueGlow}"/>
                                        
                                        <!-- D-Pad -->
                                        <Border Canvas.Left="50" Canvas.Top="60" Width="70" Height="70" Background="{StaticResource BgTertiary}" CornerRadius="16" BorderBrush="{StaticResource BgBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="DpadUp" Grid.Row="0" Grid.Column="1" Background="{StaticResource AccentBlueDim}" CornerRadius="4" Margin="4" ToolTip="D-Pad Up" AutomationProperties.Name="D-Pad Up"/>
                                                                                                <Border x:Name="DpadLeft" Grid.Row="1" Grid.Column="0" Background="{StaticResource AccentBlueDim}" CornerRadius="4" Margin="4" ToolTip="D-Pad Left" AutomationProperties.Name="D-Pad Left"/>
                                                                                                <Border x:Name="DpadCenter" Grid.Row="1" Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="4" Margin="4" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" ToolTip="D-Pad Center – L3 (⌫ Backspace)" AutomationProperties.Name="D-Pad Center"/>
                                                                                                <Border x:Name="DpadRight" Grid.Row="1" Grid.Column="2" Background="{StaticResource AccentBlueDim}" CornerRadius="4" Margin="4" ToolTip="D-Pad Right" AutomationProperties.Name="D-Pad Right"/>
                                                                                                <Border x:Name="DpadDown" Grid.Row="2" Grid.Column="1" Background="{StaticResource AccentBlueDim}" CornerRadius="4" Margin="4" ToolTip="D-Pad Down" AutomationProperties.Name="D-Pad Down"/>
                                            </Grid>
                                        </Border>

                                        <!-- Left Stick -->
                                        <Ellipse Canvas.Left="50" Canvas.Top="150" Width="70" Height="70" Stroke="{StaticResource AccentBlue}" StrokeThickness="2" Fill="Transparent" Opacity="0.3" ToolTip="Left Stick">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#3b82f6" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="LeftStickPos" Canvas.Left="80" Canvas.Top="180" Width="10" Height="10" Fill="{StaticResource AccentBlue}" Effect="{StaticResource BlueGlow}" IsHitTestVisible="False"/>

                                        <!-- Right Stick -->
                                        <Ellipse Canvas.Left="280" Canvas.Top="150" Width="70" Height="70" Stroke="{StaticResource AccentPurple}" StrokeThickness="2" Fill="Transparent" Opacity="0.3" ToolTip="Right Stick">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#8b5cf6" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="RightStickPos" Canvas.Left="310" Canvas.Top="180" Width="10" Height="10" Fill="{StaticResource AccentPurple}" Effect="{StaticResource PurpleGlow}" IsHitTestVisible="False"/>

                                        <!-- Action Buttons (A/B/X/Y) - Modern styling -->
                                        <Ellipse x:Name="BtnA" Canvas.Left="330" Canvas.Top="80" Width="42" Height="42" Fill="#ef4444" Effect="{StaticResource GoldGlow}" ToolTip="Button A" AutomationProperties.Name="Button A"/>
                                                                                <Ellipse x:Name="BtnB" Canvas.Left="380" Canvas.Top="30" Width="42" Height="42" Fill="#f59e0b" Effect="{StaticResource GoldGlow}" ToolTip="Button B" AutomationProperties.Name="Button B"/>
                                                                                <Ellipse x:Name="BtnX" Canvas.Left="280" Canvas.Top="30" Width="42" Height="42" Fill="#3b82f6" Effect="{StaticResource BlueGlow}" ToolTip="Button X" AutomationProperties.Name="Button X"/>
                                                                                <Ellipse x:Name="BtnY" Canvas.Left="330" Canvas.Top="-20" Width="42" Height="42" Fill="#a855f7" Effect="{StaticResource PurpleGlow}" ToolTip="Button Y" AutomationProperties.Name="Button Y"/>
                                        
                                        <TextBlock Canvas.Left="341" Canvas.Top="86" Text="A" Foreground="White" FontWeight="Bold" FontSize="14" IsHitTestVisible="False"/>
                                        <TextBlock Canvas.Left="391" Canvas.Top="36" Text="B" Foreground="White" FontWeight="Bold" FontSize="14" IsHitTestVisible="False"/>
                                        <TextBlock Canvas.Left="291" Canvas.Top="36" Text="X" Foreground="White" FontWeight="Bold" FontSize="14" IsHitTestVisible="False"/>
                                        <TextBlock Canvas.Left="341" Canvas.Top="-14" Text="Y" Foreground="White" FontWeight="Bold" FontSize="14" IsHitTestVisible="False"/>

                                        <!-- Trigger Indicators -->
                                        <Border x:Name="TriggerL" Canvas.Left="20" Canvas.Top="10" Width="24" Height="60" Background="{StaticResource BgTertiary}" CornerRadius="12" BorderBrush="{StaticResource AccentBlueDim}" BorderThickness="2" Opacity="0.5" ToolTip="L2 Trigger"/>
                                        <Border x:Name="TriggerR" Canvas.Left="356" Canvas.Top="10" Width="24" Height="60" Background="{StaticResource BgTertiary}" CornerRadius="12" BorderBrush="{StaticResource AccentPurpleDim}" BorderThickness="2" Opacity="0.5" ToolTip="R2 Trigger"/>
                                        <Border x:Name="BumperL" Canvas.Left="20" Canvas.Top="75" Width="24" Height="30" Background="{StaticResource BgTertiary}" CornerRadius="8" BorderBrush="{StaticResource AccentBlueDim}" BorderThickness="1" Opacity="0.5" ToolTip="L1 Bumper"/>
                                        <Border x:Name="BumperR" Canvas.Left="356" Canvas.Top="75" Width="24" Height="30" Background="{StaticResource BgTertiary}" CornerRadius="8" BorderBrush="{StaticResource AccentPurpleDim}" BorderThickness="1" Opacity="0.5" ToolTip="R1 Bumper"/>

                                        <!-- Touchpad Center -->
                                        <Border Canvas.Left="150" Canvas.Top="100" Width="100" Height="60" Background="{StaticResource BgTertiary}" CornerRadius="20" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" ToolTip="Touchpad">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                            </Border.Effect>
                                        </Border>

                                        <!-- Start/Select/PS Buttons -->
                                        <Ellipse Canvas.Left="180" Canvas.Top="115" Width="18" Height="18" Fill="#6b7280" ToolTip="Share"/>
                                        <Ellipse Canvas.Left="205" Canvas.Top="115" Width="18" Height="18" Fill="#6b7280" ToolTip="Options"/>
                                        <Ellipse x:Name="BtnPS" Canvas.Left="192" Canvas.Top="140" Width="20" Height="20" Stroke="{StaticResource AccentBlue}" StrokeThickness="2" Fill="Transparent" ToolTip="PS Button">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#3b82f6" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Quick Actions -->
                                                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="16,0,16,16" HorizontalAlignment="Stretch">
                                                            <Button x:Name="BtnCalibrateQuick" Content="Calibrate" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,0,0,8" Click="BtnCalibrateQuick_Click" AutomationProperties.Name="Quick calibrate" ToolTip="Calibrate gamepad deadzone&#x0a;Hotkey: F1"/>
                                                            <Button x:Name="BtnTestInput" Content="Test Input" Style="{StaticResource GhostButton}" Height="44" Margin="0,0,0,8" Click="BtnTestInput_Click" AutomationProperties.Name="Test input" ToolTip="Test gamepad button input&#x0a;Hotkey: F2"/>
                                                            <Button x:Name="BtnOpenRemap" Content="Button Remapping" Style="{StaticResource GhostButton}" Height="44" Click="BtnOpenRemap_Click" AutomationProperties.Name="Button remapping" ToolTip="Open button remapping settings&#x0a;Hotkey: F3"/>
                                                            <Button x:Name="BtnRadial" Content="Radial Menu" Style="{StaticResource GhostButton}" Height="44" Margin="0,8,0,0" Click="BtnRadial_Click" AutomationProperties.Name="Radial menu" ToolTip="Open radial menu configuration&#x0a;Hotkey: F4"/>
                                                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CENTER: Dynamic Panels -->
                    <Grid Grid.Column="1">
                        <!-- Base Panel -->
                        <Border x:Name="PanelBase" Style="{StaticResource GlassPanel}" Visibility="Visible" Effect="{StaticResource CardShadow}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <StackPanel x:Name="OverviewPanelContent"/>
                            </ScrollViewer>
                        </Border>

                        <!-- L1+ Panel -->
                                                <Border x:Name="PanelL1" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Panel.ZIndex="10" Effect="{StaticResource CardShadow}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                                        <StackPanel x:Name="L1PanelContent">
                                                            <TextBlock Text="L1+ Layer – Auto-Angriff &amp; Kite" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                                            <Button Content="Auto-Target aktivieren" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Aktiviert automatischen Angriff auf das nächste Ziel" AutomationProperties.Name="Auto-Target enable"/>
                                                            <Button Content="Kite-Modus aktivieren" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Aktiviert Kite-Modus (Abstand zum Gegner halten)" AutomationProperties.Name="Kite mode enable"/>
                                                            <TextBlock Text="Noch keine Layer-spezifischen Belegungen konfiguriert. Nutzen Sie den Button-Remapping-Editor um Tasten diesem Layer zuzuweisen." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                        <!-- R1+ Panel -->
                                                <Border x:Name="PanelR1" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Panel.ZIndex="10" Effect="{StaticResource CardShadow}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                                        <StackPanel x:Name="R1PanelContent">
                                                            <TextBlock Text="R1+ Layer – Mage System" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                                            <Button Content="Mage-System aktivieren" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Aktiviert automatisches Zaubern (Mage Engine)" AutomationProperties.Name="Mage system enable"/>
                                                            <Button Content="Boden-Zauber Modus" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Aktiviert Boden-Zauber mit R-Stick Zielung" AutomationProperties.Name="Ground spell mode"/>
                                                            <TextBlock Text="Noch keine Layer-spezifischen Belegungen konfiguriert." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                        <!-- L2+ Panel -->
                                                <Border x:Name="PanelL2" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Panel.ZIndex="10" Effect="{StaticResource CardShadow}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                                        <StackPanel x:Name="L2PanelContent">
                                                            <TextBlock Text="L2+ Layer – Items &amp; Potions" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                                            <Button Content="Auto-Potion aktivieren" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Aktiviert automatische Item-Verwendung (ItemManager)" AutomationProperties.Name="Auto-potion enable"/>
                                                            <Button Content="Quick-Item Slot 1" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Verwendet schnellen Item-Slot 1" AutomationProperties.Name="Quick item slot 1"/>
                                                            <TextBlock Text="Noch keine Layer-spezifischen Belegungen konfiguriert." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                        <!-- R2+ Panel -->
                                                <Border x:Name="PanelR2" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Panel.ZIndex="10" Effect="{StaticResource CardShadow}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                                        <StackPanel x:Name="R2PanelContent">
                                                            <TextBlock Text="R2+ Layer – Support &amp; Buffs" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                                            <Button Content="Support-Modus aktivieren" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Aktiviert Support-Modus (Auto-Heal Party)" AutomationProperties.Name="Support mode enable"/>
                                                            <Button Content="Buff-Status anzeigen" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,0,8" ToolTip="Zeigt aktuelle Buff-Status aller Party-Mitglieder" AutomationProperties.Name="Buff status show"/>
                                                            <TextBlock Text="Noch keine Layer-spezifischen Belegungen konfiguriert." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                        <!-- Health Panel -->
                        <Border x:Name="PanelHealth" Visibility="Collapsed" Style="{StaticResource GlassPanel}" Panel.ZIndex="10" Effect="{StaticResource CardShadow}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <StackPanel x:Name="HealthPanelContent"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Telemetrie-Panel (UI-011) -->
                        <ctrl:TelemetryPanel x:Name="TelemetryPanelControl" Visibility="Collapsed" Panel.ZIndex="10"/>

                        <!-- Info/Log Panel -->
                        <StackPanel x:Name="LogPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassPanel}" Effect="{StaticResource CardShadow}" Padding="12" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="FILTER" Style="{StaticResource Eyebrow}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LogFilterEngine" Content="Engine" IsChecked="True" Style="{StaticResource ToggleSwitch}" Margin="0,0,12,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                    <CheckBox x:Name="LogFilterInput" Content="Input" IsChecked="True" Style="{StaticResource ToggleSwitch}" Margin="0,0,12,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                    <CheckBox x:Name="LogFilterProfile" Content="Profile" IsChecked="True" Style="{StaticResource ToggleSwitch}" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassPanel}" MinHeight="220" Effect="{StaticResource CardShadow}">
                                <ScrollViewer x:Name="LogScrollViewer2" VerticalScrollBarVisibility="Auto" Padding="12">
                                    <TextBlock x:Name="LogTextBlock2" Text="" Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- RIGHT: Status Sidebar -->
                    <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Margin="8,0,0,0" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Connection Status Header -->
                            <TextBlock Grid.Row="0" Text="STATUS" Style="{StaticResource Eyebrow}" Margin="16,16,16,8"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,16,0">
                                <StackPanel Margin="16,0,16,0"/>
                            </ScrollViewer>

                            <!-- Live Log Viewer -->
                            <Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="{StaticResource RadiusMd}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" Margin="16,0,16,16" Effect="{StaticResource CardShadow}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="LIVE LOG" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}" FontSize="10" Style="{StaticResource ToggleSwitch}"/>
                                        <Button x:Name="BtnClearLog" Content="Clear" Style="{StaticResource GhostButton}" Height="28" Padding="10,0" Margin="12,0,0,0" Click="BtnClearLog_Click"/>
                                        <Button x:Name="BtnExportLog" Content="Export" Style="{StaticResource GhostButton}" Height="28" Padding="10,0" Margin="8,0,0,0" Click="BtnLogExport_Click"/>
                                    </StackPanel>
                                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" MinHeight="160" MaxHeight="240">
                                        <TextBlock x:Name="LogTextBlock" Text="" Foreground="#3A5020" FontSize="9" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <TextBlock x:Name="LogLineCount" Text="0 lines" Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>