<!-- 
    General application settings window.
    Configures sound, rumble, window mode, language, deadzone, and input preferences.
-->
<Window x:Class="RagnaController.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="Settings" Width="560" Height="680"
        MinWidth="520" MinHeight="620" ResizeMode="CanResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" Closing="Window_Closing">

    

    <!-- ROOT with radial depth gradient + glassmorphism (using centralized design system) -->
        <Border CornerRadius="{StaticResource RadiusXl}" BorderThickness="1" BorderBrush="{StaticResource BgBorder}">
            <Border.Background>
                <RadialGradientBrush Center="0.18,0" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#0f0f12" Offset="0"/>
                    <GradientStop Color="#1a1a20" Offset="0.55"/>
                    <GradientStop Color="#0f0f12" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border CornerRadius="{StaticResource RadiusXl}" ClipToBounds="True">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="22" Background="{StaticResource AccentBlue}" Effect="{StaticResource BlueGlow}" Margin="0,0,10,0"/>
                        <TextBlock Text="{core:Loc SettingsWindow_Header}" Style="{StaticResource BrandWordmark}"/>
                    </StackPanel>

                    <!-- Content -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                        <StackPanel x:Name="MainContentPanel">

                                                <!-- Search & Reset -->
                                                <Border Style="{StaticResource GlassPanelCompact}" Padding="0" CornerRadius="{StaticResource RadiusMd}" Height="44" Margin="0,0,0,16">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource GlassPanelCompact}" Padding="0" CornerRadius="{StaticResource RadiusMd}">
                                                            <TextBox x:Name="SettingsSearchBox" Height="44" Padding="14,10" TextChanged="SettingsSearchBox_TextChanged" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="15" VerticalContentAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" AutomationProperties.Name="Search settings"/>
                                                        </Border>
                                                        <Button x:Name="BtnResetSettings" Content="{core:Loc Settings_Btn_ResetAll}" Grid.Column="1" Click="BtnResetSettings_Click" Style="{StaticResource GhostButton}" Height="40" Width="150" Margin="12,0,0,0" ToolTip="{core:Loc Settings_Btn_ResetAll_Tooltip}" FontSize="13"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Profile Settings -->
                            <TextBlock Text="{core:Loc Settings_Profile}" Style="{StaticResource Eyebrow}"/>
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <ComboBox x:Name="ProfileCombo" ItemsSource="{Binding}" SelectedIndex="-1"
                                                                                   Style="{StaticResource DarkComboBox}"
                                                                                   ToolTip="{core:Loc Settings_ActiveProfile_Tooltip}"
                                                                                   SelectionChanged="ProfileCombo_SelectionChanged"/>
                    
                                    <CheckBox x:Name="ChkAutoLoadProfile" Content="{core:Loc Settings_AutoLoadProfile}"
                                                                                  Click="ChkAutoLoadProfile_Click"/>
                    
                                    <TextBlock Text="{core:Loc Settings_SaveProfileOnClose}" Style="{StaticResource BodyText}" Margin="0,10,0,6"/>
                                                                        <TextBlock x:Name="CurrentProfileText" Text="{core:Loc Settings_NoProfileLoaded}"
                                                                                   Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>

                            <!-- Engine Settings -->
                            <TextBlock Text="{core:Loc Settings_Engine}" Style="{StaticResource Eyebrow}"/>
                                                        <Border Style="{StaticResource GlassPanel}">
                                                            <StackPanel>
                                                                <CheckBox x:Name="ChkStartWithWindows" Content="{core:Loc Settings_StartWithWindows}"
                                                                          Click="ChkStartWithWindows_Click"/>
                    
                                    <CheckBox x:Name="ChkMinimizeToTray" Content="{core:Loc Settings_MinimizeToTray}"
                                                                                                              Click="ChkMinimizeToTray_Click"/>

                                                                        <!-- Engine State Display -->
                                                                        <TextBlock x:Name="EngineStateText" Text="{core:Loc Settings_EngineState_Ready}"
                                                                                   Foreground="{StaticResource TextSecondary}" FontSize="9" FontFamily="Consolas" Margin="0,10,0,6"/>

                                                                        <!-- Show Latency Checkbox -->
                                                                        <CheckBox x:Name="ChkShowLatency" Content="{core:Loc Settings_ShowLatency}"
                                                                                                              Click="ChkShowLatency_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- TASK-1902: DualSense Lightbar per Profil -->
                            <TextBlock Text="{core:Loc Settings_DualSenseLightbar}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <TextBlock Text="{core:Loc Settings_LightbarColor_Label}" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>

                                    <!-- Preset Color Swatches -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="BtnLightbarRed" Content="●" Width="30" Height="30" Margin="0,0,6,0"
                                                Background="#FF4444" Foreground="White" FontSize="16"
                                                Style="{StaticResource GhostButton}" Click="BtnLightbarColor_Click" Tag="#FF0000"
                                                ToolTip="{core:Loc Settings_LightbarColor_Red}"/>
                                        <Button x:Name="BtnLightbarBlue" Content="●" Width="30" Height="30" Margin="0,0,6,0"
                                                Background="#FF2244CC" Foreground="White" FontSize="16"
                                                Style="{StaticResource GhostButton}" Click="BtnLightbarColor_Click" Tag="#005AD2"
                                                ToolTip="{core:Loc Settings_LightbarColor_Blue}"/>
                                        <Button x:Name="BtnLightbarGreen" Content="●" Width="30" Height="30" Margin="0,0,6,0"
                                                Background="#FF44AA44" Foreground="White" FontSize="16"
                                                Style="{StaticResource GhostButton}" Click="BtnLightbarColor_Click" Tag="#00CC00"
                                                ToolTip="{core:Loc Settings_LightbarColor_Green}"/>
                                        <Button x:Name="BtnLightbarYellow" Content="●" Width="30" Height="30" Margin="0,0,6,0"
                                                Background="#FFCCAA22" Foreground="White" FontSize="16"
                                                Style="{StaticResource GhostButton}" Click="BtnLightbarColor_Click" Tag="#FFD700"
                                                ToolTip="{core:Loc Settings_LightbarColor_Gold}"/>
                                        <Button x:Name="BtnLightbarWhite" Content="●" Width="30" Height="30" Margin="0,0,6,0"
                                                Background="#FFDDDDDD" Foreground="Black" FontSize="16"
                                                Style="{StaticResource GhostButton}" Click="BtnLightbarColor_Click" Tag="#FFFFFF"
                                                ToolTip="{core:Loc Settings_LightbarColor_White}"/>
                                        <Button x:Name="BtnLightbarCyan" Content="●" Width="30" Height="30" Margin="0,0,6,0"
                                                Background="#FF44CCCC" Foreground="Black" FontSize="16"
                                                Style="{StaticResource GhostButton}" Click="BtnLightbarColor_Click" Tag="#00FFFF"
                                                ToolTip="{core:Loc Settings_LightbarColor_Cyan}"/>
                                    </StackPanel>

                                    <!-- Custom Hex Input -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{core:Loc Settings_LightbarColor_Hex}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtLightbarHex" Width="80" Text="#005AD2"
                                                 Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="13"
                                                 BorderBrush="{StaticResource BgBorder}" BorderThickness="1"
                                                 Padding="8,4" VerticalContentAlignment="Center"/>
                                        <Button Content="Apply" Click="BtnLightbarHexApply_Click"
                                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,4" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Status -->
                                    <TextBlock x:Name="LblLightbarStatus" Text="" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="9" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- TASK-2306: Cloud Sync per Profil -->
                            <TextBlock Text="{core:Loc Settings_CloudSync}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCloudSyncEnabled" Content="{core:Loc Settings_CloudSyncEnabled}"
                                              Click="ChkCloudSyncEnabled_Click"
                                              ToolTip="{core:Loc Settings_CloudSyncEnabled_Tooltip}"
                                              AutomationProperties.Name="Cloud sync enabled"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{core:Loc Settings_CloudSyncProvider}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbCloudSyncProvider" Width="150" VerticalAlignment="Center"
                                                  SelectionChanged="CmbCloudSyncProvider_SelectionChanged"
                                                  ToolTip="{core:Loc Settings_CloudSyncProvider_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{core:Loc Settings_CloudSyncToken}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtCloudSyncToken" Width="200"
                                                 Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="12"
                                                 BorderBrush="{StaticResource BgBorder}" BorderThickness="1"
                                                 Padding="8,4" VerticalContentAlignment="Center"
                                                 ToolTip="{core:Loc Settings_CloudSyncToken_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnCloudSyncTest" Content="{core:Loc Settings_CloudSyncTestConnection}"
                                                Click="BtnCloudSyncTest_Click"
                                                Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                ToolTip="{core:Loc Settings_CloudSyncTestConnection_Tooltip}"/>
                                        <Button x:Name="BtnCloudSyncUpload" Content="{core:Loc Settings_CloudSyncUpload}"
                                                Click="BtnCloudSyncUpload_Click"
                                                Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                ToolTip="{core:Loc Settings_CloudSyncUpload_Tooltip}"/>
                                        <Button x:Name="BtnCloudSyncDownload" Content="{core:Loc Settings_CloudSyncDownload}"
                                                Click="BtnCloudSyncDownload_Click"
                                                Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                ToolTip="{core:Loc Settings_CloudSyncDownload_Tooltip}"/>
                                    </StackPanel>

                                    <TextBlock x:Name="LblCloudSyncStatus" Text="" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="9" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Settings -->
                            <TextBlock Text="{core:Loc Settings_Advanced}" Style="{StaticResource Eyebrow}"/>
                                                        <Border Style="{StaticResource GlassPanel}">
                                                            <StackPanel>
                                                                <CheckBox x:Name="ChkAutoStart" Content="{core:Loc Settings_EnableAutoStart}"
                                                                                                      Click="ChkAutoStart_Click"/>

                                                                <CheckBox x:Name="ChkSound" Content="{core:Loc Settings_EnableSound}"
                                                                                                      Click="ChkSound_Click"/>

                                                                <CheckBox x:Name="ChkRumble" Content="{core:Loc Settings_EnableRumble}"
                                                                                                      Click="ChkRumble_Click"/>

                                                                <CheckBox x:Name="ChkHapticMetronome" Content="{core:Loc Settings_EnableHapticMetronome}"
                                                                                                      Click="ChkHapticMetronome_Click"/>

                                                                <CheckBox x:Name="ChkStartInMiniMode" Content="{core:Loc Settings_StartInMiniMode}"
                                                                                                      Click="ChkStartInMiniMode_Click"
                                                                                                      AutomationProperties.Name="Start in mini mode"/>

                                                                <CheckBox x:Name="ChkSmartStandby" Content="{core:Loc Settings_EnableSmartStandby}"
                                                                                                                                                                      Click="ChkSmartStandby_Click"
                                                                                                                                                                      AutomationProperties.Name="Smart standby"/>

                                                                                                                                <TextBlock Text="{core:Loc Settings_StandbyMinutes}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                                                                                                                <TextBox x:Name="TxtStandbyMinutes" Text="5"
                                                                                                                                         Foreground="{StaticResource TextPrimary}" FontSize="10" Width="60" Height="40"
                                                                                                                                         BorderBrush="{StaticResource BgBorder}" BorderThickness="1"
                                                                                                                                         Padding="8,0" Margin="0,4"/>

                                                                                                                                <CheckBox x:Name="ChkFocusLock" Content="{core:Loc Settings_EnableFocusLock}"
                                                                                                      Click="ChkFocusLock_Click"/>

                                                                <ComboBox x:Name="LogLevelCombo" 
                                                                          Width="160" Margin="0,4"
                                                                          Style="{StaticResource DarkComboBox}"
                                                                          ToolTip="{core:Loc Settings_LogLevel_Tooltip}"
                                                                          SelectionChanged="LogLevelCombo_SelectionChanged"/>
                    
                                    <CheckBox x:Name="ChkDiscordRPC" Content="{core:Loc Settings_EnableDiscordRPC}"
                                                                                                              Click="ChkDiscordRPC_Click"/>

                                                                        <CheckBox x:Name="ChkVoiceAnnouncements" Content="{core:Loc Settings_EnableVoiceAnnouncements}"
                                                                                                                                                                                      Click="ChkVoiceAnnouncements_Click"/>

                                                                                                                                                <CheckBox x:Name="ChkSkipSplash" Content="{core:Loc Settings_EnableSkipSplash}"
                                                                                                                                                                                      Click="ChkSkipSplash_Click"/>

                                                                                                                                                <CheckBox x:Name="ChkTelemetry" Content="{core:Loc Settings_EnableTelemetry}"
                                                                                                                                                                              Click="ChkTelemetry_Click"/>

                                                                                                                                                <!-- Crash Recovery & Session (FEAT-014, TECH-063) -->
                                                                                                                                                <CheckBox x:Name="ChkAutoRestartOnCrash" Content="{core:Loc Settings_AutoRestartOnCrash}"
                                                                                                                                                          Click="ChkAutoRestartOnCrash_Click"
                                                                                                                                                          ToolTip="{core:Loc Settings_AutoRestartOnCrash_Tooltip}"/>
                                                                                                                                                <CheckBox x:Name="ChkEnableSessionRecording" Content="{core:Loc Settings_EnableSessionRecording}"
                                                                                                                                                          Click="ChkEnableSessionRecording_Click"
                                                                                                                                                          ToolTip="{core:Loc Settings_EnableSessionRecording_Tooltip}"/>

                                                                                                                                                <!-- Window Behavior -->
                                                                                                                                                <CheckBox x:Name="ChkStartMinimized" Content="{core:Loc Settings_StartMinimized}"
                                                                                                                                                          Click="ChkStartMinimized_Click"
                                                                                                                                                          ToolTip="{core:Loc Settings_StartMinimized_Tooltip}"/>
                                                                                                                                                <CheckBox x:Name="ChkShowControllerViz" Content="{core:Loc Settings_ShowControllerViz}"
                                                                                                                                                          Click="ChkShowControllerViz_Click"
                                                                                                                                                          ToolTip="{core:Loc Settings_ShowControllerViz_Tooltip}"/>

                                                                                                                                                <ComboBox x:Name="LanguageCombo" 
                                                                                  Width="160" Margin="0,4"
                                                                                  Style="{StaticResource DarkComboBox}"
                                                                                  ToolTip="{core:Loc Settings_Language_Tooltip}"
                                                                                  SelectionChanged="LanguageCombo_SelectionChanged"/>

                                                                        <!-- Overlay Customization Settings -->
                                                                        <TextBlock Text="{core:Loc Settings_OverlayCustomization}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                                                                        <Border Style="{StaticResource GlassPanel}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{core:Loc Settings_OverlayTheme_Label}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                                                                <ComboBox x:Name="OverlayThemeCombo" 
                                                                                          Width="160" Margin="0,0,0,4"
                                                                                          Style="{StaticResource DarkComboBox}"
                                                                                          ToolTip="{core:Loc Settings_OverlayTheme_Tooltip}"
                                                                                          SelectionChanged="OverlayThemeCombo_SelectionChanged"/>
                                    
                                                                        <TextBlock Text="{core:Loc Settings_OverlayOpacity_Label}" Style="{StaticResource BodyText}" Margin="0,10,0,4"/>
                                                                                                                                                <Slider x:Name="OverlayOpacitySlider" Minimum="0.3" Maximum="1.0" Value="0.9" 
                                                                                                                                                        SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                                                                                                                        Margin="0,0,0,4" ValueChanged="OverlayOpacitySlider_ValueChanged"/>
                                                                                                                                                <TextBlock x:Name="OverlayOpacityValue" Text="90%" Style="{StaticResource MutedText}" FontFamily="Consolas"/>

                                                                                                                                                <TextBlock Text="{core:Loc Settings_OverlayFontScale_Label}" Style="{StaticResource BodyText}" Margin="0,10,0,4"/>
                                                                                                                                                <Slider x:Name="OverlayFontScaleSlider" Minimum="0.7" Maximum="1.5" Value="1.0" 
                                                                                                                                                        SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                                                                                                                        Margin="0,0,0,4" ValueChanged="OverlayFontScaleSlider_ValueChanged"/>
                                                                                                                                                <TextBlock x:Name="OverlayFontScaleValue" Text="100%" Style="{StaticResource MutedText}" FontFamily="Consolas"/>
                                                                                                                                            </StackPanel>
                                                                                                                                            </Border>

                                                                                                                                            <!-- Gyro Calibration -->
                                                                                                                                            <TextBlock Text="{core:Loc Settings_GyroCalibration_Label}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                                                                                                                                            <Border Style="{StaticResource GlassPanel}">
                                                                                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                                                                                    <TextBlock Text="{core:Loc Settings_GyroDeadzone_Label}" Style="{StaticResource BodyText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                                                                                    <TextBlock x:Name="GyroDeadzoneValue" Text="64" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                                                                                                                                    <Button x:Name="BtnGyroCalibrate" Content="{core:Loc Settings_GyroCalibrate_Button}" Style="{StaticResource GhostButton}" Width="100" Height="36" Margin="16,0,0,0" Click="BtnGyroCalibrate_Click" ToolTip="{core:Loc Settings_GyroCalibrate_Tooltip}" FontSize="12"/>
                                                                                                                                                    <TextBlock x:Name="GyroStatusText" Text="" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                                                                                                                </StackPanel>
                                                                                                                                            </Border>



                                                                                                                                                <!-- Multi-Monitor Support -->
                                                                            <TextBlock Text="{core:Loc Settings_OverlayMonitor_Label}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                                                                            <Border Style="{StaticResource GlassPanel}">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{core:Loc Settings_OverlayMonitor_Label}" Style="{StaticResource BodyText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                    <ComboBox x:Name="OverlayMonitorCombo" Width="200" Margin="0,0,0,4" Style="{StaticResource DarkComboBox}" SelectionChanged="OverlayMonitorCombo_SelectionChanged" ToolTip="{core:Loc Settings_OverlayMonitor_Tooltip}"/>
                                                                                    <TextBlock x:Name="OverlayMonitorInfo" Text="" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                                                </StackPanel>
                                                                            </Border>

                                                                        <!-- Accessibility (UX-017) -->
                                                                        <TextBlock Text="{core:Loc Settings_Accessibility}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                                                                        <Border Style="{StaticResource GlassPanel}">
                                                                            <StackPanel>
                                                                                <CheckBox x:Name="ChkHighContrast" Content="{core:Loc Settings_HighContrastMode}"
                                                                                                                                                              Click="ChkHighContrast_Click"
                                                                                                                                                              ToolTip="{core:Loc Settings_HighContrastTooltip}"
                                                                                                                                                              Margin="0,0,0,8"/>
                                                                                                                    <TextBlock Text="{core:Loc Settings_UIFontScale}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                                                                <Slider x:Name="FontScaleSlider" Minimum="0.85" Maximum="1.50" Value="1.0"
                                                                                        SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                                                        Margin="0,0,0,4" ValueChanged="FontScaleSlider_ValueChanged"/>
                                                                                <TextBlock x:Name="FontScaleValue" Text="100%" Style="{StaticResource MutedText}" FontFamily="Consolas"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Ragnarok Online Path Selector -->
                                                                                                                                                                                <TextBlock Text="{core:Loc Settings_RoExePath_Description}" Style="{StaticResource BodyText}" Margin="0,14,0,4"/>
                                                                                                                                                                                <Grid Margin="0,0,0,4">
                                                                                                                                                                                    <Grid.ColumnDefinitions>
                                                                                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                                                                                    </Grid.ColumnDefinitions>
                                                                                                                                                                                    <ComboBox x:Name="RoExePathCombo" 
                                                                                                                                                                                          Grid.Column="0"
                                                                                                                                                                                          Style="{StaticResource DarkComboBox}"
                                                                                                                                                                                          ToolTip="{core:Loc Settings_RoExePath_Tooltip}"
                                                                                                                                                                                          SelectionChanged="RoExePathCombo_SelectionChanged"/>
                                                                                                                                                                                    <Button x:Name="BtnBrowseRoExe" 
                                                                                                                                                                                            Grid.Column="1"
                                                                                                                                                                                            Content="{core:Loc Settings_RoExePath_BrowseBtn}"
                                                                                                                                                                                            Style="{StaticResource GhostButton}" 
                                                                                                                                                                                            Height="36" Width="90" Margin="8,0,0,0"
                                                                                                                                                                                            Click="BtnBrowseRoExe_Click"
                                                                                                                                                                                            ToolTip="{core:Loc Settings_RoExePath_Tooltip}"/>
                                                                                                                                                                                </Grid>
                                                                                                                                                                                <TextBlock x:Name="LblRoExeStatus" Text=""
                                                                                                                                                                                         Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,0,0,10"/>

                                                                                                            <!-- Calibrate Button -->
                                                                                                            <Button x:Name="BtnCalibrate" Content="{core:Loc Settings_Btn_Calibrate}"
                                                                                                                    Style="{StaticResource GhostButton}" Height="40" Padding="16,0"
                                                                                                                    Margin="0,0,0,10" Click="BtnCalibrate_Click"/>

                                    <!-- Version and Path Info -->
                                    <TextBlock x:Name="LblVersion" Text=""
                                             Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="LblSettingsPath" Text=""
                                             Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="{core:Loc Settings_Btn_Cancel}" Click="BtnCancel_Click"
                                                                                                Style="{StaticResource GhostButton}" Height="40" Padding="20,0" Margin="0,0,8,0"
                                                                                                ToolTip="{core:Loc Settings_Btn_Cancel_Tooltip}" AutomationProperties.Name="{core:Loc Settings_Btn_Cancel}"/>
                                                                                        <Button Content="{core:Loc Settings_Btn_Apply}" Click="BtnApply_Click"
                                                                                                Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0"
                                                                                                ToolTip="{core:Loc Settings_Btn_Apply_Tooltip}" AutomationProperties.Name="{core:Loc Settings_Btn_Apply}"/>
                                        </StackPanel>
                </Grid>
            </Border>
        </Border>
        </Window>