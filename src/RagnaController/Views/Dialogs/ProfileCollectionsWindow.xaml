<!--
    ProfileCollectionsWindow — TASK-2705: Profile Collections UI für das Verwalten,
    Teilen und Abonnieren von Profil-Sammlungen.
-->
<Window x:Class="RagnaController.Views.Dialogs.ProfileCollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Collections" Width="800" Height="600"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="PROFILE COLLECTIONS" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Sammlungen verwalten, teilen, abonnieren" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="Schließen" AutomationProperties.Name="Schließen"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Collections Liste -->
                <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="0" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PROFILE COLLECTIONS" Style="{StaticResource Eyebrow}" Margin="16,16,16,8"/>
                        <ListBox x:Name="CollectionList" Grid.Row="1" Margin="16,0,16,16" SelectionChanged="CollectionList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BgSecondary}" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProfileCount, StringFormat='{}{0} Profile(s)'}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Collection Details / Bearbeiten -->
                <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="20" CornerRadius="{StaticResource RadiusMd}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="COLLECTION DETAILS" Style="{StaticResource Eyebrow}" Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Name" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtName" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Beschreibung" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtDescription" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Profile in dieser Sammlung" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <ListBox x:Name="ProfileList" Height="150" Background="{StaticResource BgSecondary}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,4" CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BgSurface}" Margin="0,2">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                    <Button x:Name="BtnAddProfile" Content="+ Profil hinzufügen" Click="BtnAddProfile_Click" Style="{StaticResource GhostButton}" Height="36" Width="140" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnRemoveProfile" Content="Profil entfernen" Click="BtnRemoveProfile_Click" Style="{StaticResource DangerButton}" Height="36" Width="140" Margin="8,0,0,0" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox x:Name="ChkPublic" Content="Öffentlich teilen (Gist)" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="BtnShare" Content="Teilen" Click="BtnShare_Click" Style="{StaticResource PrimaryButton}" Height="36" Width="100" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnSubscribe" Content="Abonnieren" Click="BtnSubscribe_Click" Style="{StaticResource GhostButton}" Height="36" Width="100"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnNew" Content="+ Neu" Click="BtnNew_Click" Style="{StaticResource GhostButton}" Height="40" Width="100" Margin="0,0,8,0"/>
                            <Button x:Name="BtnDelete" Content="Löschen" Click="BtnDelete_Click" Style="{StaticResource DangerButton}" Height="40" Width="100" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="BtnSave" Content="Speichern" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Height="40" Width="100" Grid.Column="2"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource RadiusXl},{StaticResource RadiusXl}">
                <Grid VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Tipp: Profile Collections können öffentlich geteilt und von anderen Nutzern abonniert werden." Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}"/>
                    <Button Content="Schließen" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="100" Height="40"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
