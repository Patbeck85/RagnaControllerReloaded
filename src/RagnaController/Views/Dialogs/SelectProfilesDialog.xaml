<!--
    SelectProfilesDialog — Hilfsdialog für ProfileCollectionsWindow.
    Ermöglicht die Auswahl eines oder mehrerer Profile aus einer Liste.
-->
<Window x:Class="RagnaController.Views.Dialogs.SelectProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile auswählen" Width="400" Height="350"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="PROFILE AUSWÄHLEN" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="Abbrechen" AutomationProperties.Name="Abbrechen"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Wähle ein oder mehrere Profile aus (Strg/Klick für Mehrfachauswahl):"
                           Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                <ListBox x:Name="ProfileList" Grid.Row="1" Margin="0,0,0,16" SelectionMode="Extended"
                         Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BgSurface}" Margin="0,2">
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource RadiusXl},{StaticResource RadiusXl}">
                <Grid VerticalAlignment="Center" Margin="20,0">
                    <Button x:Name="BtnOk" Content="OK" Click="BtnOk_Click" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Width="100" Height="40"/>
                    <Button x:Name="BtnCancel" Content="Abbrechen" Click="BtnCancel_Click" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="100" Height="40" Margin="0,0,12,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
