<Window x:Class="RagnaController.Views.Dialogs.RumbleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rumble Editor" Width="700" Height="550"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="RUMBLE EDITOR" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — DualSense Vibrations-Patterns" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="Schließen" AutomationProperties.Name="Schließen"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Pattern Liste -->
                <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="0" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="RUMBLE PATTERNS" Style="{StaticResource Eyebrow}" Margin="16,16,16,8"/>
                        <ListBox x:Name="PatternList" Grid.Row="1" Margin="16,0,16,16" SelectionChanged="PatternList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="{StaticResource RadiusSm}" Background="{StaticResource BgSecondary}" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Frequency}" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Amplitude}" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DurationMs}" FontSize="10" Foreground="{StaticResource TextTertiary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Pattern Bearbeiten -->
                <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="20" CornerRadius="{StaticResource RadiusMd}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="PATTERN BEARBEITEN" Style="{StaticResource Eyebrow}" Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Name" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtName" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Beschreibung" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtDescription" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Wellenform" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="CmbWaveform" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Frequenz (Hz)" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="TxtFrequency" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Amplitude" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBox x:Name="TxtAmplitude" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Dauer (ms)" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtDuration" Height="36" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox x:Name="ChkLoop" Content="Loop" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkInverted" Content="Invertiert" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Wellenform-Vorschau" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <Border Height="100" Background="{StaticResource BgSurface}" BorderThickness="1" BorderBrush="{StaticResource BgBorder}" Margin="0,4,0,0">
                                        <Canvas x:Name="WaveformCanvas" Height="100" Background="Transparent"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAdd" Content="+ Neu" Click="BtnAdd_Click" Style="{StaticResource GhostButton}" Height="40" Width="100" Margin="0,0,8,0"/>
                            <Button x:Name="BtnDelete" Content="Löschen" Click="BtnDelete_Click" Style="{StaticResource DangerButton}" Height="40" Width="100" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="BtnSave" Content="Speichern" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Height="40" Width="100" Grid.Column="2"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource RadiusXl},{StaticResource RadiusXl}">
                <Grid VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Tipp: Rumble-Patterns werden mit dem Profil gespeichert und können beim Spiel starten automatisch abgespielt werden." Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}"/>
                    <Button Content="Schließen" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="100" Height="40"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>