<!--
    ProfileDiffWindow — TASK-2304: Profile Diff/Compare.
    Vergleicht zwei Profile nebeneinander und hebt Unterschiede hervor.
    Fokus auf wichtige Eigenschaften: Klasse, Lightbar, ButtonMappings, Engine-Einstellungen.
-->
<Window x:Class="RagnaController.Views.Dialogs.ProfileDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        xmlns:local="clr-namespace:RagnaController"
        Title="Profile Diff / Compare" Width="1000" Height="750"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="PROFILE DIFF / COMPARE" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Unterschiede zwischen zwei Profilen" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="Close diff window" AutomationProperties.Name="Close profile diff window"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile Selection -->
                <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" Padding="16,12" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PROFIL A" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMuted}"/>
                        <ComboBox x:Name="ProfileComboA" Grid.Row="1" Grid.Column="0" Style="{StaticResource DarkComboBox}" SelectionChanged="ProfileCombo_SelectionChanged" FontSize="14" Margin="0,6,12,0" VerticalAlignment="Center" AutomationProperties.Name="Profile A selector"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="vs" Style="{StaticResource BodyText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontWeight="Bold" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="PROFIL B" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMuted}"/>
                        <ComboBox x:Name="ProfileComboB" Grid.Row="1" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="ProfileCombo_SelectionChanged" FontSize="14" Margin="12,6,0,0" VerticalAlignment="Center" AutomationProperties.Name="Profile B selector"/>

                        <!-- Diff Controls -->
                        <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <CheckBox x:Name="ChkShowDifferencesOnly" Content="Nur Unterschiede" Style="{StaticResource ToggleSwitch}" IsChecked="False" ToolTip="Blendet identische Werte aus" AutomationProperties.Name="Show differences only" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="BtnExportReport" Content="&#xE74E;  Export" Style="{StaticResource GhostButton}" Margin="0,0,0,0" ToolTip="Diff-Report als Textdatei speichern" AutomationProperties.Name="Export diff report" Padding="12,4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Diff Results -->
                <Border Grid.Row="1" Style="{StaticResource GlassPanelCompact}" CornerRadius="{StaticResource RadiusMd}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource RadiusMd}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Eigenschaft" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="Profil A" Grid.Column="1" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="Profil B" Grid.Column="2" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="Bemerkung" Grid.Column="3" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                        </Border>

                        <!-- Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DiffResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Padding="16,10" Background="{Binding RowBackground, Converter={StaticResource StringToBrushConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PropertyName}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ValueA}" Style="{StaticResource Caption}" Foreground="{Binding ValueAColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueB}" Style="{StaticResource Caption}" Foreground="{Binding ValueBColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Remark}" Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Summary -->
                <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" Padding="16,12" CornerRadius="{StaticResource RadiusMd}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Zusammenfassung" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="100">
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Text="{Binding SummaryText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,{StaticResource RadiusXl},{StaticResource RadiusXl}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Vergleicht alle öffentlichen Profileigenschaften. Unterschiede werden farblich hervorgehoben (rot = unterschiedlich, grün = identisch)." Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
