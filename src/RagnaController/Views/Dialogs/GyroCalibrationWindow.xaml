<!--
    GyroCalibrationWindow — TASK-2401: Gyro Calibration Wizard.
    Geführter Kalibrierungs-Assistent für den DualSense-Gyroskop.
    Schritte: 1. Willkommen → 2. Hardware-Erkennung → 3. Kalibrierung (Stillhalten) → 4. Ergebnis & Speichern
-->
<Window x:Class="RagnaController.Views.Dialogs.GyroCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="Gyro Kalibrierung" Width="700" Height="550"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="GYRO KALIBRIERUNG" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — DualSense Neigungssensor kalibrieren" Style="{StaticResource BodyText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="Abbrechen" AutomationProperties.Name="Abbrechen"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Schritt-Indikator -->
                <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" Padding="16,12" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="StepTitle" Text="Schritt 1 von 4 — Willkommen" Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="StepDescription" Text="Dieser Assistent kalibriert den DualSense-Gyroskop für präzises Ziel-Zielen." Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="StepProgress" Height="4" Margin="0,8,0,0" Value="25" Maximum="4" Foreground="{StaticResource AccentGold}" Background="{StaticResource BgSurface}" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Schritte -->
                <Grid x:Name="StepsGrid" Grid.Row="1">
                    <!-- Schritt 1: Willkommen -->
                    <StackPanel x:Name="StepWelcome" Visibility="Visible">
                        <TextBlock Text="Was wird kalibriert?" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource GlassPanelCompact}" Padding="16" CornerRadius="{StaticResource RadiusMd}">
                            <StackPanel>
                                <TextBlock Text="Der DualSense-Controller besitzt einen eingebauten Gyroskop-Sensor, der Neigungsbewegungen erkennt." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="Beim Kalibrieren werden folgende Werte ermittelt:" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Margin="20,0,0,10">
                                    <TextBlock Text="• Drift-Offset (Nullpunkt, wenn der Controller still liegt)" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="• Neigungsschwelle (unter welcher Bewegung ignoriert wird)" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="• Sensitivitäts-Faktor (Grad pro Sekunde pro Hardware-Einheit)" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="Hinweis: Halte den Controller während der Kalibrierung absolut still auf einer flachen Oberfläche." Style="{StaticResource Caption}" Foreground="{StaticResource TextWarn}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="BtnWelcomeNext" Content="Weiter →" Style="{StaticResource PrimaryButton}" Click="BtnWelcomeNext_Click" Width="120" Height="40" AutomationProperties.Name="Weiter zu Hardware-Erkennung"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Schritt 2: Hardware-Erkennung -->
                    <StackPanel x:Name="StepHardware" Visibility="Collapsed">
                        <TextBlock Text="DualSense-Erkennung" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource GlassPanelCompact}" Padding="16" CornerRadius="{StaticResource RadiusMd}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                                    <Ellipse x:Name="GyroStatusIndicator" Width="16" Height="16" Fill="{StaticResource TextWarn}" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="GyroStatusText" Text="Suche nach DualSense-Controller…" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="Der Kalibrierungs-Assistent sucht nach einem verbundenen DualSense-Controller über HID." Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnRefreshHardware" Content="Erneut scannen" Style="{StaticResource GhostButton}" Click="BtnRefreshHardware_Click" Width="120" Height="40" ToolTip="Erneute DualSense-Suche starten"/>
                                    <Button x:Name="BtnHardwareSkip" Content="Überspringen (Testmodus)" Style="{StaticResource GhostButton}" Click="BtnHardwareSkip_Click" Width="150" Height="40" Margin="12,0,0,0" ToolTip="Ohne echten Controller fortfahren (Simulierte Werte)"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="BtnHardwareBack" Content="← Zurück" Style="{StaticResource GhostButton}" Click="BtnHardwareBack_Click" Width="120" Height="40"/>
                            <Button x:Name="BtnHardwareNext" Content="Weiter →" Style="{StaticResource PrimaryButton}" Click="BtnHardwareNext_Click" Width="120" Height="40" IsEnabled="False" AutomationProperties.Name="Weiter zu Kalibrierung"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Schritt 3: Kalibrierung (Stillhalten) -->
                    <StackPanel x:Name="StepCalibration" Visibility="Collapsed">
                        <TextBlock Text="Controller stillhalten" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource GlassPanelCompact}" Padding="24" CornerRadius="{StaticResource RadiusMd}">
                            <StackPanel>
                                <TextBlock x:Name="CalibrationInstruction" Text="Lege den DualSense auf eine flache Oberfläche und bewege ihn NICHT." Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                                
                                <!-- Visual: Bubble Level -->
                                <Border x:Name="LevelBorder" Width="200" Height="200" Background="{StaticResource BgSurface}" CornerRadius="100" BorderBrush="{StaticResource BgBorder}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Ellipse x:Name="BubbleEllipse" Width="40" Height="40" Fill="{StaticResource AccentGold}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="BubbleTransform" X="0" Y="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <TextBlock Text="Neigung X:" Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPitchValue" Text="0.0°" Style="{StaticResource BodyText}" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Neigung Y:" Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtYawValue" Text="0.0°" Style="{StaticResource BodyText}" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <ProgressBar x:Name="CalibrationProgress" Width="200" Height="6" Maximum="100" Value="0" Foreground="{StaticResource AccentGold}" Background="{StaticResource BgSurface}" BorderThickness="0"/>
                                </StackPanel>
                                <TextBlock x:Name="CalibrationStatusText" Text="Bereit — starte die Kalibrierung." Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextAlignment="Center"/>
                                <Button x:Name="BtnStartCalibration" Content="Kalibrierung starten" Style="{StaticResource PrimaryButton}" Click="BtnStartCalibration_Click" Width="160" Height="44" Margin="0,12,0,0" AutomationProperties.Name="Starte Gyro-Kalibrierung"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="BtnCalibrationBack" Content="← Zurück" Style="{StaticResource GhostButton}" Click="BtnCalibrationBack_Click" Width="120" Height="40"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Schritt 4: Ergebnis -->
                    <StackPanel x:Name="StepResult" Visibility="Collapsed">
                        <TextBlock Text="Kalibrierung abgeschlossen" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource GlassPanelCompact}" Padding="24" CornerRadius="{StaticResource RadiusMd}">
                            <StackPanel>
                                <TextBlock Text="Die folgenden Kalibrierungswerte wurden ermittelt:" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Drift-Offset Pitch:" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}" Width="140"/>
                                    <TextBlock x:Name="TxtResultPitchOffset" Text="0.00" Style="{StaticResource BodyText}" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Drift-Offset Yaw:" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}" Width="140"/>
                                    <TextBlock x:Name="TxtResultYawOffset" Text="0.00" Style="{StaticResource BodyText}" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Drift-Schwelle:" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}" Width="140"/>
                                    <TextBlock x:Name="TxtResultThreshold" Text="64" Style="{StaticResource BodyText}" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Sensitivität:" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}" Width="140"/>
                                    <TextBlock x:Name="TxtResultSensitivity" Text="1.00" Style="{StaticResource BodyText}" FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkApplyToProfile" Content="Werte auf aktuelles Profil anwenden" IsChecked="True" Margin="0,0,0,16" Foreground="{StaticResource TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnResultBack" Content="← Zurück" Style="{StaticResource GhostButton}" Click="BtnResultBack_Click" Width="120" Height="40"/>
                                    <Button x:Name="BtnResultFinish" Content="Fertigstellen" Style="{StaticResource PrimaryButton}" Click="BtnResultFinish_Click" Width="120" Height="40" IsEnabled="False" AutomationProperties.Name="Speichern und schließen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,{StaticResource RadiusXl},{StaticResource RadiusXl}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tipp: Kalibriere den Controller vor dem ersten Gebrauch und nach jedem Firmware-Update des Controllers." Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
