<Window x:Class="RagnaController.Views.Dialogs.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RagnaController"
        mc:Ignorable="d"
        Title="RagnaController — First-Run Wizard"
        Height="500" Width="700"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        AllowsTransparency="False" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="WizardTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="WizardSubtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style TargetType="Button" x:Key="WizardButton">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="Button" x:Key="WizardPrimaryButton" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        </Style>
        <Style TargetType="TextBox" x:Key="WizardTextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <Ellipse Width="48" Height="48" Fill="{StaticResource AccentBlue}"
                     HorizontalAlignment="Left" Margin="0,0,16,12"/>
            <TextBlock Text="Welcome to RagnaController" Style="{StaticResource WizardTitle}"/>
            <TextBlock Text="Set up your RO controller setup in a few steps."
                       Style="{StaticResource WizardSubtitle}"/>
        </StackPanel>

        <!-- Wizard Content Area -->
        <Border Grid.Row="1" Style="{StaticResource GlassPanel}"
                CornerRadius="{StaticResource RadiusLg}" Padding="32">
            <Grid>
                <!-- Schritt 1: Willkommen -->
                <StackPanel x:Name="StepWelcome" Visibility="Visible">
                    <TextBlock Text="Step 1 of 4 — Setup" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="1.6" MaxWidth="520">
                        <Run Text="RagnaController controls Ragnarok Online with your gamepad. "/>
                        <Run Text="Let us quickly check if everything is ready:"/>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Live}">✓</Run>
                        <Run Text=" Controller detection (XInput / DualSense)"/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Live}">✓</Run>
                        <Run Text=" RO client path (ragexe.exe / sakexe.exe)"/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Live}">✓</Run>
                        <Run Text=" First profile for your character"/>
                    </TextBlock>
                </StackPanel>

                <!-- Schritt 2: RO-Client-Pfad -->
                <StackPanel x:Name="StepRoPath" Visibility="Collapsed">
                    <TextBlock Text="Step 2 of 4 — Select RO Client" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Margin="0,0,16,16">
                        Select your Ragnarok Online client executable (e.g. ragexe.exe or sakexe.exe).
                    </TextBlock>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RoExePathTextBox" Style="{StaticResource WizardTextBox}"
                                 Grid.Column="0"
                                 TextChanged="RoExePathTextBox_TextChanged"
                                 ToolTip="Path to ragexe.exe or sakexe.exe"
                                 AutomationProperties.Name="RO client path"/>
                        <Button x:Name="BtnBrowseRoExe" Content="Browse…" Style="{StaticResource WizardButton}"
                                Grid.Column="1" Click="BtnBrowseRoExe_Click"/>
                    </Grid>
                    <TextBlock x:Name="RoPathStatus" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Schritt 3: Controller-Erkennung -->
                <StackPanel x:Name="StepController" Visibility="Collapsed">
                    <TextBlock Text="Step 3 of 4 — Detect Controller" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Margin="0,0,16,16">
                        Connect your gamepad (Xbox, DualSense, etc.). RagnaController detects it automatically.
                    </TextBlock>
                    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusMd}" Padding="20" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ControllerStatusIndicator" Width="16" Height="16"
                                     Fill="{StaticResource Danger}" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                            <TextBlock x:Name="ControllerStatusText"
                                       Text="Kein Controller erkannt — verbinde deinen Gamepad und klicke auf Aktualisieren"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRefreshController" Content="Refresh" Style="{StaticResource WizardButton}"
                            Click="BtnRefreshController_Click"/>
                    <Button x:Name="BtnSkipController" Content="Skip" Style="{StaticResource WizardButton}"
                            Click="BtnSkipController_Click"/>
                </StackPanel>

                <!-- Schritt 4: Erstes Profil -->
                <StackPanel x:Name="StepProfile" Visibility="Collapsed">
                    <TextBlock Text="Step 4 of 4 — First Profile" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Margin="0,0,16,16">
                        Create your first character profile. You can add more profiles later.
                    </TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameTextBox" Style="{StaticResource WizardTextBox}"
                                 Grid.Column="0"
                                 ToolTip="Name for your first profile (e.g. 'Mage', 'Knight')"
                                 AutomationProperties.Name="Profile name"
                                 TextChanged="ProfileNameTextBox_TextChanged"/>
                    </Grid>
                    <!-- Class / Template Selection -->
                    <TextBlock Text="CLASS / TEMPLATE" Style="{StaticResource Eyebrow}" Margin="0,4,0,4"/>
                    <ComboBox x:Name="ClassTemplateCombo" Style="{StaticResource DarkComboBox}" Height="44"
                              FontSize="15" FontFamily="Segoe UI Variable, Segoe UI"
                              SelectionChanged="ClassTemplateCombo_SelectionChanged"
                              AutomationProperties.Name="Class template"/>
                    <TextBlock x:Name="TemplateDescription" Foreground="{StaticResource TextSecondary}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="520" Margin="0,8,0,4"/>
                    <TextBlock x:Name="TemplateSkills" Foreground="{StaticResource TextTertiary}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="520" Margin="0,0,0,16"/>
                    <!-- Button Mapping Preview -->
                    <TextBlock Text="BUTTON MAPPING" Style="{StaticResource Eyebrow}" Margin="0,4,0,4"/>
                    <Border Style="{StaticResource GlassPanelCompact}" Padding="16" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- A -->
                            <TextBlock Text="A:" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="15"
                                       Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="BtnAMap" Style="{StaticResource DarkComboBox}" Height="40"
                                      Grid.Row="0" Grid.Column="1" SelectionChanged="ButtonMap_SelectionChanged"
                                      AutomationProperties.Name="Button A mapping"/>
                            <!-- B -->
                            <TextBlock Text="B:" Foreground="{StaticResource Danger}" FontWeight="Bold" FontSize="15"
                                       Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,12,0"/>
                            <ComboBox x:Name="BtnBMap" Style="{StaticResource DarkComboBox}" Height="40"
                                      Grid.Row="0" Grid.Column="3" SelectionChanged="ButtonMap_SelectionChanged"
                                      AutomationProperties.Name="Button B mapping"/>
                            <!-- X -->
                            <TextBlock Text="X:" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="15"
                                       Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,12,0"/>
                            <ComboBox x:Name="BtnXMap" Style="{StaticResource DarkComboBox}" Height="40"
                                      Grid.Row="1" Grid.Column="1" SelectionChanged="ButtonMap_SelectionChanged"
                                      AutomationProperties.Name="Button X mapping"/>
                            <!-- Y -->
                            <TextBlock Text="Y:" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="15"
                                       Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="16,10,12,0"/>
                            <ComboBox x:Name="BtnYMap" Style="{StaticResource DarkComboBox}" Height="40"
                                      Grid.Row="1" Grid.Column="3" SelectionChanged="ButtonMap_SelectionChanged"
                                      AutomationProperties.Name="Button Y mapping"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCreateProfile" Content="Create profile" Style="{StaticResource WizardPrimaryButton}"
                                Grid.Column="1" Click="BtnCreateProfile_Click" IsEnabled="False"/>
                    </Grid>
                    <TextBlock x:Name="ProfileStatus" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Footer -->
        <Border Grid.Row="2" Padding="0,24,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnBack" Content="Back" Style="{StaticResource WizardButton}"
                        Click="BtnBack_Click" IsEnabled="False"/>
                <Button x:Name="BtnNext" Content="Next" Style="{StaticResource WizardPrimaryButton}"
                        Click="BtnNext_Click"/>
                <Button x:Name="BtnFinish" Content="Finish" Style="{StaticResource WizardPrimaryButton}"
                        Click="BtnFinish_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
