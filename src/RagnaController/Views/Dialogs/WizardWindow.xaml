<Window x:Class="RagnaController.Views.Dialogs.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RagnaController"
        mc:Ignorable="d"
        Title="RagnaController — First-Run Wizard"
        Height="500" Width="700"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        AllowsTransparency="False" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="WizardTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="WizardSubtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style TargetType="Button" x:Key="WizardButton">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="Button" x:Key="WizardPrimaryButton" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
        </Style>
        <Style TargetType="TextBox" x:Key="WizardTextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <Ellipse Width="48" Height="48" Fill="{StaticResource AccentBlue}"
                     HorizontalAlignment="Left" Margin="0,0,16,12"/>
            <TextBlock Text="Willkommen bei RagnaController" Style="{StaticResource WizardTitle}"/>
            <TextBlock Text="Richte deine RO-Controller-Einrichtung in wenigen Schritten ein."
                       Style="{StaticResource WizardSubtitle}"/>
        </StackPanel>

        <!-- Wizard Content Area -->
        <Border Grid.Row="1" Style="{StaticResource GlassPanel}"
                CornerRadius="{StaticResource RadiusLg}" Padding="32">
            <Grid>
                <!-- Schritt 1: Willkommen -->
                <StackPanel x:Name="StepWelcome" Visibility="Visible">
                    <TextBlock Text="Schritt 1 von 4 — Einrichtung" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="1.6" MaxWidth="520">
                        <Run Text="RagnaController steuert Ragnarok Online mit deinem Gamepad. "/>
                        <Run Text="Lass uns kurz prüfen, ob alles bereit ist:"/>
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Live}">✓</Run>
                        <Run Text=" Controller-Erkennung (XInput / DualSense)"/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Live}">✓</Run>
                        <Run Text=" RO-Client-Pfad (ragexe.exe / sakexe.exe)"/>
                        <LineBreak/>
                        <Run FontWeight="SemiBold" Foreground="{StaticResource Live}">✓</Run>
                        <Run Text=" Erstes Profil für deinen Charakter"/>
                    </TextBlock>
                </StackPanel>

                <!-- Schritt 2: RO-Client-Pfad -->
                <StackPanel x:Name="StepRoPath" Visibility="Collapsed">
                    <TextBlock Text="Schritt 2 von 4 — RO-Client auswählen" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Margin="0,0,16,16">
                        Wähle deine Ragnarok Online Client-Executable (z.B. ragexe.exe oder sakexe.exe).
                    </TextBlock>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RoExePathTextBox" Style="{StaticResource WizardTextBox}"
                                 Grid.Column="0"
                                 TextChanged="RoExePathTextBox_TextChanged"
                                 ToolTip="Pfad zur ragexe.exe oder sakexe.exe"/>
                        <Button x:Name="BtnBrowseRoExe" Content="Durchsuchen…" Style="{StaticResource WizardButton}"
                                Grid.Column="1" Click="BtnBrowseRoExe_Click"/>
                    </Grid>
                    <TextBlock x:Name="RoPathStatus" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Schritt 3: Controller-Erkennung -->
                <StackPanel x:Name="StepController" Visibility="Collapsed">
                    <TextBlock Text="Schritt 3 von 4 — Controller erkennen" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Margin="0,0,16,16">
                        Verbinde deinen Gamepad (Xbox, DualSense, etc.). RagnaController erkennt ihn automatisch.
                    </TextBlock>
                    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusMd}" Padding="20" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ControllerStatusIndicator" Width="16" Height="16"
                                     Fill="{StaticResource Danger}" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                            <TextBlock x:Name="ControllerStatusText"
                                       Text="Kein Controller erkannt — verbinde deinen Gamepad und klicke auf Aktualisieren"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRefreshController" Content="Aktualisieren" Style="{StaticResource WizardButton}"
                            Click="BtnRefreshController_Click"/>
                    <Button x:Name="BtnSkipController" Content="Überspringen" Style="{StaticResource WizardButton}"
                            Click="BtnSkipController_Click"/>
                </StackPanel>

                <!-- Schritt 4: Erstes Profil -->
                <StackPanel x:Name="StepProfile" Visibility="Collapsed">
                    <TextBlock Text="Schritt 4 von 4 — Erstes Profil" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                    <TextBlock TextWrapping="Wrap" MaxWidth="520" Margin="0,0,16,16">
                        Erstelle dein erstes Charakter-Profil. Du kannst später weitere Profile hinzufügen.
                    </TextBlock>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameTextBox" Style="{StaticResource WizardTextBox}"
                                 Grid.Column="0"
                                 ToolTip="Name für dein erstes Profil (z.B. 'Magier', 'Ritter')"/>
                        <Button x:Name="BtnCreateProfile" Content="Profil erstellen" Style="{StaticResource WizardPrimaryButton}"
                                Grid.Column="1" Click="BtnCreateProfile_Click" IsEnabled="False"/>
                    </Grid>
                    <TextBlock x:Name="ProfileStatus" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Footer -->
        <Border Grid.Row="2" Padding="0,24,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnBack" Content="Zurück" Style="{StaticResource WizardButton}"
                        Click="BtnBack_Click" IsEnabled="False"/>
                <Button x:Name="BtnNext" Content="Weiter" Style="{StaticResource WizardPrimaryButton}"
                        Click="BtnNext_Click"/>
                <Button x:Name="BtnFinish" Content="Fertigstellen" Style="{StaticResource WizardPrimaryButton}"
                        Click="BtnFinish_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
