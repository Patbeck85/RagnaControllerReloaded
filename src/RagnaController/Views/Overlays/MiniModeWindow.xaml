<!-- 
    Compact click-through HUD.
    Minimal overlay showing core state without blocking game interaction.
-->
<Window x:Class="RagnaController.Views.Overlays.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="RagnaController Mini" Width="300" Height="64"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" WindowStartupLocation="Manual" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        ToolTip="{core:Loc MiniMode_Tooltip}">

    

    <Border x:Name="RootBorder" Style="{StaticResource GlassPanel}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1.5" CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Status Indicator (Left) -->
                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="14" Height="14" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource Green}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 2. Profile Info (Center) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileText" Text="{core:Loc MiniMode_Profile}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Black" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable, Segoe UI" AutomationProperties.Name="{core:Loc MiniMode_ProfileLabel}"/>
                        <TextBlock x:Name="StateText" Text="{core:Loc MiniMode_State}" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" AutomationProperties.Name="{core:Loc MiniMode_StateLabel}"/>
                    </StackPanel>

                    <!-- 3. Battery Info (Right of center) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryText" Text="100%" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="{core:Loc MiniMode_BatteryLabel}"/>
                        <!-- Battery Icon (SVG) -->
                        <Viewbox Width="18" Height="11" VerticalAlignment="Center">
                            <Grid>
                                <Border Width="24" Height="11" CornerRadius="2" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1.5"/>
                                <Border Width="2" Height="5" Background="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,0,-2,0"/>
                                <Border x:Name="BatteryFill" Width="22" Height="7" Background="{StaticResource Green}" CornerRadius="1" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                            </Grid>
                        </Viewbox>
                    </StackPanel>

                    <!-- 4. Quick Profile Switch Button (TASK-2009) -->
                    <Button x:Name="BtnProfileSwitch" Grid.Column="3" Content="P" Style="{StaticResource GhostButton}" Width="30" Height="30" Click="BtnProfileSwitch_Click" ToolTip="Switch active profile (keyboard: P)" AutomationProperties.Name="Switch profile" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>

                    <!-- 5. Help / Shortcuts Button (TASK-2009) -->
                    <Button x:Name="BtnHelp" Grid.Column="4" Content="?" Style="{StaticResource GhostButton}" Width="30" Height="30" Click="BtnHelp_Click" ToolTip="Show keyboard shortcuts" AutomationProperties.Name="Show shortcuts" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>

                    <!-- Persistent Click-Through Mode Indicator (bottom accent line) -->
                                <Border x:Name="ClickThroughIndicator" Grid.ColumnSpan="5" Height="3" VerticalAlignment="Bottom" Background="{StaticResource Blue}" CornerRadius="1.5" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Blue}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <!-- Click-Through Indicator Overlay (transient label on toggle) -->
                        <Border x:Name="ClickThroughHint" Grid.ColumnSpan="5" Style="{StaticResource GlassPanel}" Background="{StaticResource Blue}" CornerRadius="24" Visibility="Collapsed" Opacity="0.95">
                <TextBlock Text="🔵 CLICK-THROUGH · Esc exits" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
            </Border>
        </Grid>
    </Border>
</Window>