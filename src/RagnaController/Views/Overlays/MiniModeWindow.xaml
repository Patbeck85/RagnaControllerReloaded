<!-- 
    Compact click-through HUD.
    Minimal overlay showing core state without blocking game interaction.
-->
<Window x:Class="RagnaController.Views.Overlays.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RagnaController Mini" Width="240" Height="56"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" WindowStartupLocation="Manual" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        ToolTip="Drag to move. Right-click to toggle Click-Through mode (Esc exits).">

    

    <Border x:Name="RootBorder" Style="{StaticResource GlassPanel}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1.5" CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Status Indicator (Left) -->
            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="14" Height="14" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse.Effect>
                    <DropShadowEffect Color="{StaticResource Green}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 2. Profile Info (Center) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileText" Text="NOVICE" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Black" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable, Segoe UI" AutomationProperties.Name="Profile name"/>
                <TextBlock x:Name="StateText" Text="READY" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas" AutomationProperties.Name="Connection state"/>
            </StackPanel>

            <!-- 3. Battery Info (Right) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="BatteryText" Text="100%" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Battery level"/>
                <!-- Battery Icon (SVG) -->
                <Viewbox Width="18" Height="11" VerticalAlignment="Center">
                    <Grid>
                        <Border Width="24" Height="11" CornerRadius="2" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1.5"/>
                        <Border Width="2" Height="5" Background="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,0,-2,0"/>
                        <Border x:Name="BatteryFill" Width="22" Height="7" Background="{StaticResource Green}" CornerRadius="1" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                    </Grid>
                </Viewbox>
            </StackPanel>

            <!-- Persistent Click-Through Mode Indicator (bottom accent line) -->
            <Border x:Name="ClickThroughIndicator" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Bottom" Background="{StaticResource Blue}" CornerRadius="1.5" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Blue}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <!-- Click-Through Indicator Overlay (transient label on toggle) -->
            <Border x:Name="ClickThroughHint" Grid.ColumnSpan="3" Style="{StaticResource GlassPanel}" Background="{StaticResource Blue}" CornerRadius="24" Visibility="Collapsed" Opacity="0.95">
                <TextBlock Text="🔵 CLICK-THROUGH · Esc exits" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
            </Border>
        </Grid>
    </Border>
</Window>