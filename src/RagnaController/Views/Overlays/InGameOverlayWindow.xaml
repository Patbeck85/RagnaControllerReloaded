<!-- 
    Borderless in-game state HUD.
    Shows layer text, state label, and skill cooldowns overlaying the game client.
-->
<Window x:Class="RagnaController.Views.Overlays.InGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RagnaController.Models"
        Title="RagnaController Overlay"
        Width="240" Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary><!-- Class Icon ImageBrush Resource -->
            <ImageBrush x:Key="ClassIconBrush" Stretch="Uniform"/>
            <SolidColorBrush x:Key="AccentRed" Color="#FF5252"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Root: Glassmorphism card with rounded corners, subtle gold border, shadow -->
    <Border Style="{StaticResource GlassPanelCompact}"
            BorderBrush="#44C9A646"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="12,10"
            Margin="0"
            Effect="{StaticResource CardShadow}"
            PreviewMouseLeftButtonDown="Overlay_PreviewMouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Class Icon + Profile Name + Layer indicator -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Class Icon -->
                <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,6,0" CornerRadius="3"
                        Background="{StaticResource ClassIconBrush}">
                    <Border.Effect>
                        <DropShadowEffect Color="#C9A646" BlurRadius="4" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                </Border>

                <!-- Profile Name -->
                <TextBlock Grid.Column="1"
                           x:Name="ProfileText"
                           Text="NOVICE"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}"
                           VerticalAlignment="Center"
                           ToolTip="Current profile name">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Static label -->
                <TextBlock Grid.Column="2"
                           Text="LAYER"
                           FontFamily="Consolas"
                           FontSize="8.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

                <!-- Dynamic layer text: BASE / L1+ / R1+ / L2+ / R2+ -->
                <TextBlock Grid.Column="3"
                           x:Name="LayerText"
                           Text="BASE"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Black"
                           Foreground="{StaticResource Live}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#39FF8C" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Current layer: BASE / L1+ / R1+ / L2+ / R2+" 
                                 Style="{StaticResource GlassPanel}"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="11"
                                 Background="{StaticResource BgTertiary}"
                                 BorderBrush="{StaticResource BgBorder}"/>
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>

            <!-- Row 0 separator -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" 
                    Background="{StaticResource BgBorder}" Margin="0,2,0,0" Opacity="0.3"/>

            <!-- Row 1: Combat state / Class label -->
            <TextBlock Grid.Row="1"
                       x:Name="StateText"
                       Text="IDLE"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentPurple}"
                       HorizontalAlignment="Left"
                       Margin="0,6,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Combat state: IDLE / COMBAT / STUN / CRITICAL" 
                             Style="{StaticResource GlassPanel}"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="11"
                             Background="{StaticResource BgTertiary}"
                             BorderBrush="{StaticResource BgBorder}"/>
                </ToolTipService.ToolTip>
            </TextBlock>

            <!-- Row 2: Battery level + Skill Cooldown -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Battery indicator -->
                            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" CornerRadius="3">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Icons/battery_full.png" Stretch="Uniform"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#C9A646" BlurRadius="3" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>

                            <!-- Battery text -->
                            <TextBlock Grid.Column="1"
                                       x:Name="BatteryText"
                                       Text="100%"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>

                            <!-- Skill Cooldown - Glassmorphism pill -->
                            <Border Grid.Column="2" Width="34" Height="18" Margin="6,0,0,0" 
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="{StaticResource GlassPanelGradient}"
                                    BorderBrush="{StaticResource BgBorder}"
                                    BorderThickness="1"
                                    Effect="{StaticResource CardShadow}">
                                <TextBlock x:Name="CooldownText"
                                           Text="0s"
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="2,0"/>
                            </Border>
                        </Grid>

                        <!-- Row 3: Skill Cooldown Bars (F1-F12) - FEAT-031 -->
                                    <Border Grid.Row="3" Margin="0,8,0,0" 
                                            Visibility="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="SKILL COOLDOWNS" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding SkillCooldowns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="2,0" Width="44">
                                                            <TextBlock Text="{Binding KeyName}" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" TextAlignment="Center" Margin="0,0,0,2"/>
                                                            <Border Width="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownBarWidth}" Height="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownBarHeight}" CornerRadius="2" Background="#2A2A3A" BorderBrush="{StaticResource BgBorder}" BorderThickness="0.5">
                                                                <Border Width="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownBarWidth}" Background="{Binding Color}" CornerRadius="2" Opacity="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownOpacity}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding RemainingTime, StringFormat='{}{0}s'}" FontSize="7" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 4: Buff/Debuff Timers - FEAT-032 -->
                                    <Border Grid.Row="4" Margin="0,8,0,0" 
                                            Visibility="{Binding Source={x:Static local:Settings.Default}, Path=OverlayBuffTimersEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="BUFFS / DEBUFFS" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding BuffTimers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="2,0" Width="52">
                                                            <TextBlock Text="{Binding Name}" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="48" Margin="0,0,0,2"/>
                                                            <Border Width="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownBarWidth}" Height="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownBarHeight}" CornerRadius="2" Background="#2A2A3A" BorderBrush="{StaticResource BgBorder}" BorderThickness="0.5">
                                                                                                    <Border Width="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownBarWidth}" Background="{Binding BarColor}" CornerRadius="2" Opacity="{Binding Source={x:Static local:Settings.Default}, Path=OverlayCooldownOpacity}"/>
                                                                                                </Border>
                                                                                                <TextBlock Text="{Binding RemainingText}" FontSize="7" FontFamily="Consolas" Foreground="{Binding BarColor}" TextAlignment="Center" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 5: HP/SP Overlay (OCR) - FEAT-033 -->
                                    <Border Grid.Row="5" Margin="0,8,0,0" 
                                            Visibility="{Binding Source={x:Static local:Settings.Default}, Path=OverlayHpSpEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="HP / SP" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="HP:" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="HpText" Text="--" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,0,8,0"/>
                                                <TextBlock Text="SP:" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="SpText" Text="--" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        </Border>

                                        <!-- Row 6: Target-Info Overlay (OCR) - FEAT-034 -->
                                        <Border Grid.Row="6" Margin="0,8,0,0" 
                                        Visibility="{Binding Source={x:Static local:Settings.Default}, Path=OverlayTargetInfoEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Margin="0,2">
                                        <TextBlock Text="TARGET" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Name:" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="TargetNameText" Text="--" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Lvl:" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="TargetLevelText" Text="--" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="HP:" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="TargetHpText" Text="--" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Dist:" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="TargetDistText" Text="--" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,0"/>
                                        </StackPanel>
                                        </StackPanel>
                                        </Border>

                                        <!-- Row 7: Damage Numbers Overlay (FEAT-036) -->
                                        <Border Grid.Row="7" Margin="0,8,0,0" 
                                                Visibility="{Binding Source={x:Static local:Settings.Default}, Path=OverlayDamageNumbersEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="DAMAGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                                <ItemsControl x:Name="DamageNumbersItems" ItemsSource="{Binding DamageNumbers}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                            <Setter Property="Opacity" Value="{Binding Opacity}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                                                                            <DataTemplate>
                                                                                                                <TextBlock Text="{Binding AmountText}" FontSize="{Binding Source={x:Static local:Settings.Default}, Path=OverlayDamageFontSize}" FontWeight="Bold" Foreground="{Binding Source={x:Static local:Settings.Default}, Path=OverlayDamageColor, Converter={StaticResource StringToBrushConverter}}" FontFamily="Consolas"/>
                                                                                                            </DataTemplate>
                                                                                                        </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                </Grid>
                            </Border>
                        </Window>