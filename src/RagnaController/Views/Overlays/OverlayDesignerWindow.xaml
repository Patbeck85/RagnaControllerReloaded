<!--
    Overlay Designer Window.
    Erlaubt Drag & Drop Positionierung der Overlay-Elemente und Speichern/Laden von Layout-Presets.
    FEAT-035: Overlay-Designer mit visueller Positionierung.
-->
<Window x:Class="RagnaController.Views.Overlays.OverlayDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RagnaController.Models"
        Title="RagnaController – Overlay Designer"
        Width="500" Height="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="DraggableElement" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,12" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentBlue}" Effect="{StaticResource BlueGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="OVERLAY DESIGNER" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource WindowControlButtonClose}" ToolTip="Close window" AutomationProperties.Name="Close overlay designer"/>
                </Grid>
            </Border>

            <!-- Snap-to-Grid & Controls -->
            <StackPanel Grid.Row="0" Grid.RowSpan="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,16,0">
                <CheckBox x:Name="ChkSnapToGrid" Content="Snap to Grid" Style="{StaticResource ToggleSwitch}" IsChecked="True" ToolTip="Snap overlay elements to 10px grid" AutomationProperties.Name="Snap to grid" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Designer Canvas -->
            <Border Grid.Row="1" Style="{StaticResource GlassPanelCompact}" BorderBrush="#44C9A646" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
                <Canvas x:Name="DesignerCanvas" Background="#1A1A2A" Width="400" Height="280" ClipToBounds="True">
                    <!-- Grid Lines -->
                    <ItemsControl x:Name="GridLines" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Overlay Element Vorschau: Skill Cooldowns -->
                    <Border x:Name="ElemSkillCooldowns" Style="{StaticResource DraggableElement}" Canvas.Left="20" Canvas.Top="20" Width="120" Height="40" MouseLeftButtonDown="Element_MouseLeftButtonDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseLeftButtonUp">
                        <TextBlock Text="SKILL COOLDOWNS (F1-F12)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Overlay Element Vorschau: Buff/Debuff Timers -->
                    <Border x:Name="ElemBuffTimers" Style="{StaticResource DraggableElement}" Canvas.Left="160" Canvas.Top="20" Width="120" Height="40" MouseLeftButtonDown="Element_MouseLeftButtonDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseLeftButtonUp">
                        <TextBlock Text="BUFFS / DEBUFFS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Overlay Element Vorschau: HP/SP -->
                    <Border x:Name="ElemHpSp" Style="{StaticResource DraggableElement}" Canvas.Left="20" Canvas.Top="80" Width="100" Height="30" MouseLeftButtonDown="Element_MouseLeftButtonDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseLeftButtonUp">
                        <TextBlock Text="HP / SP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Overlay Element Vorschau: Target-Info -->
                    <Border x:Name="ElemTargetInfo" Style="{StaticResource DraggableElement}" Canvas.Left="140" Canvas.Top="80" Width="140" Height="30" MouseLeftButtonDown="Element_MouseLeftButtonDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseLeftButtonUp">
                        <TextBlock Text="TARGET INFO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Overlay Element Vorschau: Class Icon + Profile -->
                    <Border x:Name="ElemProfile" Style="{StaticResource DraggableElement}" Canvas.Left="20" Canvas.Top="130" Width="120" Height="30" MouseLeftButtonDown="Element_MouseLeftButtonDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseLeftButtonUp">
                        <TextBlock Text="PROFIL + CLASS ICON" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Canvas>
            </Border>

            <!-- Preset Controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Content="Zurücksetzen" Click="BtnReset_Click" Margin="0,0,8,0" Padding="12,6" Style="{StaticResource GhostButton}"/>
                <Button x:Name="BtnLoadPreset" Content="Preset laden" Click="BtnLoadPreset_Click" Margin="0,0,8,0" Padding="12,6" Style="{StaticResource GhostButton}"/>
                <Button x:Name="BtnSavePreset" Content="Preset speichern" Click="BtnSavePreset_Click" Margin="0,0,8,0" Padding="12,6" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
