<!-- 
    Handheld device UI for ROG Ally / Steam Deck.
    Big-picture interface optimized for handheld screen sizes.
-->
<Window x:Class="RagnaController.Views.Overlays.HandheldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="RagnaController"
        WindowState="Maximized" WindowStyle="None"
        Background="Transparent" Foreground="{StaticResource TextPrimary}"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    

    <!-- ROOT with radial depth gradient + glassmorphism -->
    <Border CornerRadius="{StaticResource RadiusXl}" BorderThickness="1" BorderBrush="{StaticResource BgBorder}">
        <Border.Background>
            <RadialGradientBrush Center="0.18,0" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#0f0f12" Offset="0"/>
                <GradientStop Color="#1a1a20" Offset="0.55"/>
                <GradientStop Color="#0f0f12" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Border CornerRadius="{StaticResource RadiusXl}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <!-- ── TOP BAR ─────────────────────────────────────────────────── -->
                <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0">
                    <Grid Margin="40,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="4" Height="28" Background="{StaticResource AccentBlue}" Effect="{StaticResource BlueGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                                                <TextBlock Text="RAGNACONTROLLER" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DeviceLabel" Text="" FontSize="13" Foreground="{StaticResource TextTertiary}" FontWeight="Medium" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource GlassPanelCompact}" Padding="12,4" CornerRadius="{StaticResource RadiusSm}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Live}" VerticalAlignment="Center" Margin="0,0,6,0" Effect="{StaticResource GoldGlow}"/>
                                    <TextBlock x:Name="ActiveProfileText" Text="No profile loaded"
                                               FontSize="15" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               FontFamily="Segoe UI Variable, Segoe UI"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassPanelCompact}" Padding="12,4" CornerRadius="{StaticResource RadiusSm}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ControllerDot" Width="10" Height="10"
                                                                                 Fill="{StaticResource Live}" VerticalAlignment="Center" Margin="0,0,8,0" Effect="{StaticResource GoldGlow}"/>
                                    <TextBlock x:Name="ControllerStatusText" Text="Controller disconnected"
                                                                                   FontSize="15" Foreground="{StaticResource Live}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                   FontFamily="Segoe UI Variable, Segoe UI"/>
                                </StackPanel>
                            </Border>
                            <!-- UX-020: Battery status for handheld devices -->
                            <Border Style="{StaticResource GlassPanelCompact}" Padding="12,4" CornerRadius="{StaticResource RadiusSm}" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="BatteryDot" Width="8" Height="8" Fill="{StaticResource Live}" VerticalAlignment="Center" Margin="0,0,6,0" Effect="{StaticResource GoldGlow}"/>
                                    <TextBlock x:Name="BatteryStatusText" Text="{core:Loc Handheld_BatteryLabel}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── TILE GRID ──────────────────────────────────────────────── -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="48,16" Padding="8">
                                    <UniformGrid Columns="3" Rows="3" Margin="0,16">
                                        <Button x:Name="BtnPlay" Style="{StaticResource PrimaryButton}" Height="180" Click="BtnPlay_Click" ToolTip="Start Game" AutomationProperties.Name="Play game tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="56" Foreground="{StaticResource LiveColor}"
                                                           HorizontalAlignment="Center" Effect="{StaticResource GoldGlow}"/>
                                                <TextBlock Text="{core:Loc Handheld_PlayTile}" FontSize="22" FontWeight="Black"
                                                                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="{core:Loc Handheld_PlayDesc}" FontSize="13"
                                                                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnProfiles" Style="{StaticResource GhostButton}" Height="180" Click="BtnProfiles_Click" ToolTip="Profile Management" AutomationProperties.Name="Profiles tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="👥" FontSize="56" HorizontalAlignment="Center" Effect="{StaticResource GoldGlow}"/>
                                                <TextBlock Text="{core:Loc Handheld_ProfilesTile}" FontSize="22" FontWeight="Black"
                                                                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="{core:Loc Handheld_ProfilesDesc}" FontSize="13"
                                                                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnOverlay" Style="{StaticResource GhostButton}" Height="180" Click="BtnOverlay_Click" ToolTip="Toggle Overlay" AutomationProperties.Name="Mini overlay tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📺" FontSize="56" Foreground="{StaticResource AccentBlue}"
                                                           HorizontalAlignment="Center" Effect="{StaticResource BlueGlow}"/>
                                                <TextBlock Text="MINI OVERLAY" FontSize="22" FontWeight="Black"
                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="Compact in-game HUD" FontSize="13"
                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnSettings" Style="{StaticResource GhostButton}" Height="180" Click="BtnSettings_Click" ToolTip="Settings" AutomationProperties.Name="Settings tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⚙" FontSize="56" Foreground="{StaticResource AccentPurple}"
                                                           HorizontalAlignment="Center" Effect="{StaticResource PurpleGlow}"/>
                                                <TextBlock Text="SETTINGS" FontSize="22" FontWeight="Black"
                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="Deadzone, Gyro" FontSize="13"
                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnCommunity" Style="{StaticResource GhostButton}" Height="180" Click="BtnCommunity_Click" ToolTip="Community Hub" AutomationProperties.Name="Community hub tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🌐" FontSize="56" HorizontalAlignment="Center" Effect="{StaticResource GoldGlow}"/>
                                                <TextBlock Text="{core:Loc Handheld_CommunityTile}" FontSize="22" FontWeight="Black"
                                                                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="{core:Loc Handheld_CommunityDesc}" FontSize="13"
                                                                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnControllerTest" Style="{StaticResource GhostButton}" Height="180" Click="BtnControllerTest_Click" ToolTip="Test controller buttons" AutomationProperties.Name="Controller test tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎮" FontSize="56" Foreground="{StaticResource AccentGold}"
                                                           HorizontalAlignment="Center" Effect="{StaticResource GoldGlow}"/>
                                                <TextBlock Text="CONTROLLER TEST" FontSize="20" FontWeight="Black"
                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="Test all buttons &amp; sticks" FontSize="13"
                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnMacroEditor" Style="{StaticResource GhostButton}" Height="180" Click="BtnMacroEditor_Click" ToolTip="Macro Editor" AutomationProperties.Name="Macro editor tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⌨" FontSize="56" Foreground="{StaticResource AccentBlue}"
                                                           HorizontalAlignment="Center" Effect="{StaticResource BlueGlow}"/>
                                                <TextBlock Text="{core:Loc Handheld_MacroTile}" FontSize="20" FontWeight="Black"
                                                                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="{core:Loc Handheld_MacroDesc}" FontSize="13"
                                                                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnQuickProfile" Style="{StaticResource GhostButton}" Height="180" Click="BtnQuickProfile_Click" ToolTip="Quick profile switch" AutomationProperties.Name="Quick profile switch tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🔄" FontSize="56" Foreground="{StaticResource LiveColor}"
                                                           HorizontalAlignment="Center" Effect="{StaticResource GoldGlow}"/>
                                                <TextBlock Text="{core:Loc Handheld_QuickProfileTile}" FontSize="20" FontWeight="Black"
                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="{core:Loc Handheld_QuickProfileDesc}" FontSize="13"
                                                                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnExit" Style="{StaticResource DangerButton}" Height="180" Click="BtnExit_Click" ToolTip="Exit Application" AutomationProperties.Name="Exit application tile">
                                            <StackPanel Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⏻" FontSize="56" Foreground="#FF5252"
                                                           HorizontalAlignment="Center" Effect="{StaticResource CardShadow}"/>
                                                <TextBlock Text="{core:Loc Handheld_ExitTile}" FontSize="22" FontWeight="Black"
                                                                                                           Margin="0,16,0,0" HorizontalAlignment="Center"
                                                                                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <TextBlock Text="{core:Loc Handheld_ExitDesc}" FontSize="13"
                                                                                                           Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </ScrollViewer>

                <!-- ── FOOTER: Controller-Hints ─────────────────────────────────── -->
                <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource RadiusMd},{StaticResource RadiusMd}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontFamily="Segoe UI Variable, Segoe UI">
                            <Run Text="D-Pad"/>
                            <Run Foreground="{StaticResource TextTertiary}" Text="  Navigate    "/>
                            <Run Foreground="{StaticResource LiveColor}" FontWeight="Bold" Text="Ⓐ"/>
                            <Run Foreground="{StaticResource TextTertiary}" Text="  Select    "/>
                            <Run Foreground="{StaticResource AccentPurple}" FontWeight="Bold" Text="Ⓑ"/>
                            <Run Foreground="{StaticResource TextTertiary}" Text="  Back    "/>
                            <Run Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Text="Start"/>
                            <Run Foreground="{StaticResource TextTertiary}" Text="  Enter Game"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>