<Window x:Class="RagnaController.RadialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radial Menu Setup" Width="720" Height="760"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/UI2026DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎯" Foreground="{StaticResource AccentGold}" Margin="0,0,10,0" FontSize="16" Effect="{StaticResource NeonGlow}"/>
                        <TextBlock Text="RADIAL MENU SETUP" Style="{StaticResource BrandWordmark}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" Width="36" Height="36" Style="{StaticResource GhostButton}" ToolTip="Close radial setup window"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource GlassPanelCompact}" Margin="16,0,16,0" Padding="20">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18" FontWeight="SemiBold">
                        <Run Text="Trigger: Hold "/>
                        <Run Foreground="{StaticResource AccentGold}" FontWeight="Black" Text="LT + RT"/>
                        <Run Text=" simultaneously → Aim Right Stick → Release triggers to execute."/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" Margin="0,0,0,8" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Foreground="{StaticResource AccentGold}" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="15,0"/>
                        <TextBlock Grid.Column="1" Text="DISPLAY NAME" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Grid.Column="2" Text="COMMAND / CHAT" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Grid.Column="3" Text="KEY BINDING" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Grid.Column="4" Text="EMOTES" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsStack" Margin="0,10,0,0"/>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource RadiusXl},{StaticResource RadiusXl}" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextTertiary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="Leave blank to disable a slot. "/>
                        <Run Foreground="{StaticResource AccentGold}" Text="8 Slots"/>
                        <Run Text=" = 8 directions."/>
                    </TextBlock>
                    <Button Content="SAVE RADIAL" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="140" Height="40" ToolTip="Save radial menu configuration"/>
                </Grid>
            </Border>
            <Grid x:Name="EmoteGalleryOverlay" Grid.RowSpan="4" Background="#E6080A0F" Visibility="Collapsed">
                <Border Style="{StaticResource GlassPanel}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="{StaticResource Radius2Xl}" Width="640" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource GoldGlow}">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="SELECT EMOTE" Style="{StaticResource BrandWordmark}" FontSize="16" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="BtnCloseGallery_Click" HorizontalAlignment="Right" Width="36" Height="36" Style="{StaticResource GhostButton}" ToolTip="Close emote gallery"/>
                        </Grid>

                        <!-- Status + Buttons -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EmoteStatusText"
                                       Grid.Column="0"
                                       Text="Emoji fallback active"
                                       Style="{StaticResource BodyText}" FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="1"
                                    Content="⬇ Download from iROWiki"
                                    Click="BtnDownloadWiki_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="36" Padding="15,0"
                                    FontSize="11"
                                    ToolTip="Download emote images from iROWiki to improve gallery"/>
                        </Grid>

                        <!-- Emote-Galerie -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <ItemsControl x:Name="EmoteList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="4" Width="96" Height="88"
                                                Style="{StaticResource GhostButton}"
                                                Click="BtnSelectEmote_Click" Tag="{Binding}">
                                            <StackPanel VerticalAlignment="Center">
                                                <!-- Echtes Bild wenn vorhanden -->
                                                <Image Source="{Binding ImagePath}"
                                                       Visibility="{Binding ImageVisibility}"
                                                       Width="36" Height="36" Stretch="Uniform"
                                                       Margin="0,0,0,4"/>
                                                <!-- Emoji-Fallback wenn kein Bild -->
                                                <TextBlock Text="{Binding FallbackEmoji}"
                                                           Visibility="{Binding EmojiVisibility}"
                                                           FontSize="26" HorizontalAlignment="Center"
                                                           Margin="0,0,0,4" LineHeight="32"/>
                                                <TextBlock Text="{Binding Command}"
                                                           FontSize="11" Foreground="{StaticResource AccentGold}"
                                                           FontWeight="Bold" HorizontalAlignment="Center"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="9" Foreground="{StaticResource TextSecondary}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>