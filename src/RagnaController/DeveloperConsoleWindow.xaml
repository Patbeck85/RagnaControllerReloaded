<Window x:Class="RagnaController.DeveloperConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Console" Width="800" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">

    <Border Background="#F2000000" BorderBrush="#3DDB6E" BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#3DDB6E" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text=">_ RAGNA_CONTROLLER LIVE DEBUG" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#3DDB6E" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear" Click="BtnClear_Click" Foreground="#3DDB6E" Background="Transparent" BorderThickness="1" BorderBrush="#3DDB6E" Padding="10,2" Margin="0,0,10,0" FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                    <Button Content="X" Click="BtnClose_Click" Foreground="#FF3A52" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Console Output -->
            <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#2A3245" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" Foreground="#00FF00" TextWrapping="Wrap" Padding="10"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
