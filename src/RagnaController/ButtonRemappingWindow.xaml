<Window x:Class="RagnaController.ButtonRemappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Button Remapping" Width="1200" Height="850"
        MinWidth="900" MinHeight="640"
        Background="Transparent" Foreground="#F0F4F8"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="LayerButton" TargetType="Button" BasedOn="{StaticResource ConsoleGhostBtn}"><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="LayerButtonActive" TargetType="Button" BasedOn="{StaticResource ConsolePrimaryBtn}"><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/></Style>
    </Window.Resources>
    <Border Background="#080A0F" BorderBrush="#2A3245" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#2A3245" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🎮" Foreground="#E5B842" Margin="0,0,10,0" FontSize="16" Effect="{StaticResource NeonGlow}"/><TextBlock Text="BUTTON REMAPPING" FontWeight="Bold" FontSize="14" Foreground="#F0F4F8"/></StackPanel>
                    <Button Content="✕" Click="BtnCancel_Click" HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="#A1B0C5" FontSize="14" ToolTip="Close window"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="25">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="25">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="CONTROLLER PREVIEW" FontSize="12" FontWeight="Black" Foreground="#E5B842" Margin="0,0,0,20" HorizontalAlignment="Center" Effect="{StaticResource NeonGlow}"/>
                        <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"><ContentControl x:Name="PreviewContainer"/></Viewbox>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20" Margin="15,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="SELECT LAYER" FontSize="12" FontWeight="Black" Foreground="#E5B842" Margin="0,0,0,15" HorizontalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Select the controller layer (BASE / L1+ / R1+ / L2+ / R2+)" Foreground="#E5B842" FontSize="11"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <UniformGrid Columns="5" HorizontalAlignment="Stretch">
                                <Button x:Name="LayerBase" Content="BASE" Click="LayerBtn_Click" Style="{StaticResource LayerButtonActive}" Tag=""/>
                                <Button x:Name="LayerL1" Content="L1" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="L1+"/>
                                <Button x:Name="LayerR1" Content="R1" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="R1+"/>
                                <Button x:Name="LayerL2" Content="L2" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="L2+"/>
                                <Button x:Name="LayerR2" Content="R2" Click="LayerBtn_Click" Style="{StaticResource LayerButton}" Tag="R2+"/>
                            </UniformGrid>
                            <Rectangle Height="1" Fill="#2A3245" Margin="0,20,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                            <StackPanel>
                                <!-- D-Pad -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="D-Pad" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                        <Slider x:Name="DpadSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="DpadSlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="DpadValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Left Stick -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Left Stick" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                        <Slider x:Name="LStickSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="LStickSlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="LStickValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Right Stick -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Right Stick" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                        <Slider x:Name="RStickSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="RStickSlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="RStickValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- L1/R1 -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="L1/R1" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                        <Slider x:Name="L1R1Slider" Minimum="-100" Maximum="100" Value="0" ValueChanged="L1R1Slider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="L1R1Value" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- L2/R2 -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="L2/R2" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                        <Slider x:Name="L2R2Slider" Minimum="-100" Maximum="100" Value="0" ValueChanged="L2R2Slider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="L2R2Value" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Turbo -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Turbo" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                        <Slider x:Name="TurboSlider" Minimum="1" Maximum="10" Value="3" ValueChanged="TurboSlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TurboValue" Text="3.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Turbo Test -->
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Turbo Test" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <CheckBox x:Name="ChkTurboTest" Content="Enable" Foreground="#7D8B9E" FontSize="10" Margin="0,0,10,0" Click="ChkTurboTest_Click"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnTurboTest" Content="▶ Test" Width="75" Height="36" Margin="10,0,0,0" Style="{StaticResource ConsoleGhostBtn}" Click="BtnTurboTest_Click"/>
                                </Grid>

                                <!-- Turbo Frequency Text -->
                                <TextBlock x:Name="TurboFreqText" Text="" Foreground="#3A8EFF" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Margin="0,6,0,0"/>
                        
                                <!-- Ground Spell & Self Cast Toggles -->
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Spell Toggles" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <CheckBox x:Name="GroundSpellCheckbox" Content="Ground Spell (Aim with R-Stick)" Foreground="#F0F4F8" FontSize="12" FontWeight="SemiBold" Margin="0,0,15,0" Checked="SpellCheckbox_Changed"/>
                                            <CheckBox x:Name="SelfCastCheckbox" Content="Self-Cast (Snap to Center)" Foreground="#E5B842" FontSize="12" FontWeight="SemiBold" Margin="0,0,15,0" Checked="SpellCheckbox_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <!-- D-Pad -->
                        <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="D-Pad" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                <Slider x:Name="DpadPreviewSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="DpadPreviewSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="DpadPreviewValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Left Stick -->
                        <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Left Stick" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                <Slider x:Name="LStickPreviewSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="LStickPreviewSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="LStickPreviewValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Right Stick -->
                        <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Right Stick" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                <Slider x:Name="RStickPreviewSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="RStickPreviewSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="RStickPreviewValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- L1/R1 -->
                        <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="L1/R1" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                <Slider x:Name="L1R1PreviewSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="L1R1PreviewSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="L1R1PreviewValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- L2/R2 -->
                        <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="L2/R2" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                <Slider x:Name="L2R2PreviewSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="L2R2PreviewSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="L2R2PreviewValue" Text="0.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Turbo -->
                        <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Turbo" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Button Content="↺" Click="ResetBtn_Click" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#3A4560" FontSize="11" Cursor="Hand" ToolTip="Reset to default"/>
                                <Slider x:Name="TurboPreviewSlider" Minimum="1" Maximum="10" Value="3" ValueChanged="TurboPreviewSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TurboPreviewValue" Text="3.00" Style="{StaticResource SliderValue}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Turbo Test -->
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Turbo Test" Foreground="#7D8B9E" FontSize="10" FontWeight="Bold" Margin="0,0,10,0"/>
                                <CheckBox x:Name="ChkTurboTestPreview" Content="Enable" Foreground="#7D8B9E" FontSize="10" Margin="0,0,10,0" Click="ChkTurboTestPreview_Click"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnTurboTestPreview" Content="▶ Test" Width="75" Height="36" Margin="10,0,0,0" Style="{StaticResource ConsoleGhostBtn}" Click="BtnTurboTestPreview_Click"/>
                        </Grid>

                        <!-- Turbo Frequency Text -->
                        <TextBlock x:Name="TurboFreqTextPreview" Text="" Foreground="#3A8EFF" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#07090D" BorderBrush="#2A3245" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="SAVE &amp; CLOSE" Style="{StaticResource ConsolePrimaryBtn}" Width="160" Height="40" Margin="0,0,15,0" Click="BtnSave_Click" ToolTip="Save settings and close window"/>
                    <Button Content="CANCEL" Style="{StaticResource ConsoleGhostBtn}" Width="110" Height="40" Click="BtnCancel_Click" ToolTip="Discard changes and close window"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
