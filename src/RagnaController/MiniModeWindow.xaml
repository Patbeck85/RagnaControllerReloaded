<Window x:Class="RagnaController.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RagnaController Mini" Width="220" Height="50"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" WindowStartupLocation="Manual" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        ToolTip="Drag to move. Right-click to toggle Click-Through mode. Start+Back to close.">

    <Border x:Name="RootBorder" Background="#CC080A0F" BorderBrush="#2A3245" BorderThickness="1.5" CornerRadius="25">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Status Indicator (Left) -->
            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="12" Height="12" Fill="#3DDB6E" VerticalAlignment="Center" Margin="0,0,10,0">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#3DDB6E" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 2. Profile Info (Center) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileText" Text="NOVICE" Foreground="#F0F4F8" FontSize="13" FontWeight="Black" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StateText" Text="READY" Foreground="#E5B842" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
            </StackPanel>

            <!-- 3. Battery Info (Right) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="BatteryText" Text="100%" Foreground="#7D8B9E" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <!-- Battery Icon (SVG) -->
                <Viewbox Width="16" Height="10" VerticalAlignment="Center">
                    <Grid>
                        <Border Width="22" Height="10" CornerRadius="2" BorderBrush="#7D8B9E" BorderThickness="1.5"/>
                        <Border Width="2" Height="4" Background="#7D8B9E" HorizontalAlignment="Right" Margin="0,0,-2,0"/>
                        <Border x:Name="BatteryFill" Width="20" Height="6" Background="#3DDB6E" CornerRadius="1" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                    </Grid>
                </Viewbox>
            </StackPanel>

            <!-- Click-Through Indicator Overlay -->
            <Border x:Name="ClickThroughHint" Grid.ColumnSpan="3" Background="#E61A2535" CornerRadius="20" Visibility="Collapsed">
                <TextBlock Text="🔵 CLICK-THROUGH" Foreground="#3A8EFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
