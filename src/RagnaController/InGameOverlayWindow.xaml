<Window x:Class="RagnaController.InGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RagnaController Overlay"
        Width="200" Height="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Use centralized UI2026DesignSystem from App.xaml -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/UI2026DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Class Icon ImageBrush Resource -->
            <ImageBrush x:Key="ClassIconBrush" Stretch="Uniform"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Root: Glassmorphism card with rounded corners, subtle gold border, shadow -->
    <Border Style="{StaticResource GlassPanelCompact}"
            BorderBrush="#44C9A646"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="12,10"
            Margin="0"
            Effect="{StaticResource CardShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Class Icon + Profile Name + Layer indicator -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Class Icon -->
                <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,6,0" CornerRadius="3"
                        Background="{StaticResource ClassIconBrush}">
                    <Border.Effect>
                        <DropShadowEffect Color="#C9A646" BlurRadius="4" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                </Border>

                <!-- Profile Name -->
                <TextBlock Grid.Column="1"
                           x:Name="ProfileText"
                           Text="NOVICE"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}"
                           VerticalAlignment="Center"
                           ToolTip="Current profile name">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Static label -->
                <TextBlock Grid.Column="2"
                           Text="LAYER"
                           FontFamily="Consolas"
                           FontSize="8.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

                <!-- Dynamic layer text: BASE / L1+ / R1+ / L2+ / R2+ -->
                <TextBlock Grid.Column="3"
                           x:Name="LayerText"
                           Text="BASE"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Black"
                           Foreground="{StaticResource Live}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#39FF8C" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Current layer: BASE / L1+ / R1+ / L2+ / R2+" 
                                 Style="{StaticResource GlassPanel}"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="11"
                                 Background="{StaticResource BgTertiary}"
                                 BorderBrush="{StaticResource BgBorder}"/>
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>

            <!-- Row 0 separator -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" 
                    Background="{StaticResource BgBorder}" Margin="0,2,0,0" Opacity="0.3"/>

            <!-- Row 1: Combat state / Class label -->
            <TextBlock Grid.Row="1"
                       x:Name="StateText"
                       Text="IDLE"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentPurple}"
                       HorizontalAlignment="Left"
                       Margin="0,6,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Combat state: IDLE / COMBAT / STUN / CRITICAL" 
                             Style="{StaticResource GlassPanel}"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="11"
                             Background="{StaticResource BgTertiary}"
                             BorderBrush="{StaticResource BgBorder}"/>
                </ToolTipService.ToolTip>
            </TextBlock>

            <!-- Row 2: Battery level + Skill Cooldown -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Battery indicator -->
                <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" CornerRadius="3">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/Icons/battery_full.png" Stretch="Uniform"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#C9A646" BlurRadius="3" ShadowDepth="0" Opacity="0.3"/>
                    </Border.Effect>
                </Border>

                <!-- Battery text -->
                <TextBlock Grid.Column="1"
                           x:Name="BatteryText"
                           Text="100%"
                           FontFamily="Consolas"
                           FontSize="10"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>

                <!-- Skill Cooldown - Glassmorphism pill -->
                <Border Grid.Column="2" Width="34" Height="18" Margin="6,0,0,0" 
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{StaticResource GlassPanelGradient}"
                        BorderBrush="{StaticResource BgBorder}"
                        BorderThickness="1"
                        Effect="{StaticResource CardShadow}">
                    <TextBlock x:Name="CooldownText"
                               Text="0s"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="2,0"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>