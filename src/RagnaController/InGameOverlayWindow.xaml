<Window x:Class="RagnaController.InGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RagnaController Overlay"
        Width="170" Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">

    <!-- Root border: semi-transparent dark panel, rounded corners, thin gold border -->
    <Border Background="#CC080A0F"
            BorderBrush="#44E5B842"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0→1 separator (visual only) -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#22E5B842" Margin="0,2,0,0"/>

            <!-- Row 0: Profile Name + Class Badge + Layer indicator -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Class Icon -->
                <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,6,0">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/Classes/Novice.png" Stretch="Uniform"/>
                    </Border.Background>
                </Border>

                <!-- Profile Name -->
                <TextBlock Grid.Column="1"
                           x:Name="ProfileText"
                           Text="NOVICE"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#E5B842"
                           VerticalAlignment="Center"
                           ToolTip="Current profile name"/>

                <!-- Static label -->
                <TextBlock Grid.Column="2"
                           Text="LAYER"
                           FontFamily="Consolas"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="#44E5B842"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

                <!-- Dynamic layer text: BASE / L1+ / R1+ / L2+ / R2+ -->
                <TextBlock Grid.Column="3"
                           x:Name="LayerText"
                           Text="BASE"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Black"
                           Foreground="#E5B842"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#E5B842" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Current layer: BASE / L1+ / R1+ / L2+ / R2+" Foreground="#E5B842" FontSize="11"/>
                    </ToolTipService.ToolTip>
                </TextBlock>
            </Grid>

            <!-- Row 1: Combat state label -->
            <TextBlock Grid.Row="1"
                       x:Name="StateText"
                       Text="IDLE"
                       FontFamily="Consolas"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#3FB8E0"
                       HorizontalAlignment="Left"
                       Margin="0,8,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#3FB8E0" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Combat state: IDLE / COMBAT / STUN / CRITICAL" Foreground="#3FB8E0" FontSize="11"/>
                </ToolTipService.ToolTip>
            </TextBlock>

            <!-- Row 2: Battery level + Skill Cooldown -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Battery indicator -->
                <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/Icons/battery_full.png" Stretch="Uniform"/>
                    </Border.Background>
                </Border>

                <!-- Battery text -->
                <TextBlock Grid.Column="1"
                           x:Name="BatteryText"
                           Text="100%"
                           FontFamily="Consolas"
                           FontSize="10"
                           Foreground="#7D8B9E"
                           VerticalAlignment="Center"/>

                <!-- Skill Cooldown -->
                <Border Grid.Column="2" Width="30" Height="16" Margin="6,0,0,0" CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#44E5B842" Offset="0"/>
                            <GradientStop Color="#88E5B842" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="CooldownText"
                               Text="0s"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="2"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>