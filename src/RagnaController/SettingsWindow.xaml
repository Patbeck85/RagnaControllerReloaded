<Window x:Class="RagnaController.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="680"
        MinWidth="520" MinHeight="620" ResizeMode="CanResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" Closing="Window_Closing">

    <Window.Resources>
        <!-- Use centralized UI2026DesignSystem from App.xaml -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/UI2026DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ROOT with radial depth gradient + glassmorphism (using centralized design system) -->
        <Border CornerRadius="{StaticResource RadiusXl}" BorderThickness="1" BorderBrush="{StaticResource BgBorder}">
            <Border.Background>
                <RadialGradientBrush Center="0.18,0" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#0f0f12" Offset="0"/>
                    <GradientStop Color="#1a1a20" Offset="0.55"/>
                    <GradientStop Color="#0f0f12" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border CornerRadius="{StaticResource RadiusXl}" ClipToBounds="True">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="22" Background="{StaticResource AccentBlue}" Effect="{StaticResource BlueGlow}" Margin="0,0,10,0"/>
                        <TextBlock Text="RAGNACONTROLLER" Style="{StaticResource BrandWordmark}"/>
                        <Border Background="{StaticResource BgTertiary}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SETTINGS" Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Profile Settings -->
                            <TextBlock Text="PROFILE" Style="{StaticResource Eyebrow}"/>
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <ComboBox x:Name="ProfileCombo" ItemsSource="{Binding}" SelectedIndex="-1"
                                              Style="{StaticResource DarkComboBox}"
                                              ToolTip="Active profile"/>
                    
                                    <CheckBox x:Name="ChkAutoLoadProfile" Content="Auto-load last profile"
                                              Click="ChkAutoLoadProfile_Click"/>
                    
                                    <TextBlock Text="Save current profile on close" Style="{StaticResource BodyText}" Margin="0,10,0,6"/>
                                    <TextBlock x:Name="CurrentProfileText" Text="No profile loaded"
                                               Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>

                            <!-- Engine Settings -->
                            <TextBlock Text="ENGINE" Style="{StaticResource Eyebrow}"/>
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows"
                                              Click="ChkStartWithWindows_Click"/>
                    
                                    <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray on close"
                                              Margin="0,4"/>
                    
                                    <!-- Engine State Display -->
                                    <TextBlock x:Name="EngineStateText" Text="Ready"
                                               Foreground="{StaticResource TextSecondary}" FontSize="9" FontFamily="Consolas" Margin="0,10,0,6"/>
                    
                                    <!-- Show Latency Checkbox -->
                                    <CheckBox x:Name="ChkShowLatency" Content="Show Latency"
                                              Margin="0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Settings -->
                            <TextBlock Text="ADVANCED" Style="{StaticResource Eyebrow}"/>
                            <Border Style="{StaticResource GlassPanel}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoStart" Content="Enable Auto-Start"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkSound" Content="Enable Sound"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkRumble" Content="Enable Rumble Feedback"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkHapticMetronome" Content="Enable Haptic Metronome"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkStartInMiniMode" Content="Start in Mini Mode"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkSmartStandby" Content="Enable Smart Standby (AFK Battery Saver)"
                                              Margin="0,4"/>
                    
                                    <TextBox x:Name="TxtStandbyMinutes" Text="5"
                                             Foreground="{StaticResource TextPrimary}" FontSize="10" Width="60" Height="40"
                                             BorderBrush="{StaticResource BgBorder}" BorderThickness="1"
                                             Padding="8,0" Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkFocusLock" Content="Enable Focus Lock"
                                              Margin="0,4"/>
                    
                                    <ComboBox x:Name="LogLevelCombo" 
                                              Width="160" Margin="0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              ToolTip="Set the minimum log level for file output"
                                              SelectionChanged="LogLevelCombo_SelectionChanged"/>
                    
                                    <CheckBox x:Name="ChkDiscordRPC" Content="Enable Discord Rich Presence"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkVoiceAnnouncements" Content="Enable Voice Announcements"
                                              Margin="0,4"/>
                    
                                    <CheckBox x:Name="ChkTelemetry" Content="Enable Anonymous Telemetry"
                                              Margin="0,4"/>
                    
                                    <ComboBox x:Name="LanguageCombo" 
                                              Width="160" Margin="0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              ToolTip="Select the application language"
                                              SelectionChanged="LanguageCombo_SelectionChanged"/>

                                    <!-- Overlay Customization Settings -->
                                                                <TextBlock Text="OVERLAY CUSTOMIZATION" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
                                                                <Border Style="{StaticResource GlassPanel}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Theme" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                                                        <ComboBox x:Name="OverlayThemeCombo" 
                                                                                  Width="160" Margin="0,0,0,4"
                                                                                  Style="{StaticResource DarkComboBox}"
                                                                                  ToolTip="Select the overlay visual theme (Neon/Soft/Dark)"
                                                                                  SelectionChanged="OverlayThemeCombo_SelectionChanged"/>
                                    
                                                                        <TextBlock Text="Opacity" Style="{StaticResource BodyText}" Margin="0,10,0,4"/>
                                                                        <Slider x:Name="OverlayOpacitySlider" Minimum="0.3" Maximum="1.0" Value="0.9" 
                                                                                SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                                                Margin="0,0,0,4" ValueChanged="OverlayOpacitySlider_ValueChanged"/>
                                                                        <TextBlock x:Name="OverlayOpacityValue" Text="90%" Style="{StaticResource MutedText}" FontFamily="Consolas"/>
                                    
                                                                        <TextBlock Text="Font Scale" Style="{StaticResource BodyText}" Margin="0,10,0,4"/>
                                                                        <Slider x:Name="OverlayFontScaleSlider" Minimum="0.7" Maximum="1.5" Value="1.0" 
                                                                                SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                                                Margin="0,0,0,4" ValueChanged="OverlayFontScaleSlider_ValueChanged"/>
                                                                        <TextBlock x:Name="OverlayFontScaleValue" Text="100%" Style="{StaticResource MutedText}" FontFamily="Consolas"/>
                                                                    </StackPanel>
                                                                </Border>

                            <!-- Ragnarok Online Path Selector -->
                                    <TextBlock Text="Ragnarok Online Setup" Style="{StaticResource BodyText}" Margin="0,14,0,4"/>
                                    <ComboBox x:Name="RoExePathCombo" 
                                              Width="400" Margin="0,0,0,4"
                                              Style="{StaticResource DarkComboBox}"
                                              ToolTip="Select or browse for the Ragnarok Online executable"
                                              SelectionChanged="RoExePathCombo_SelectionChanged"/>
                                    <TextBlock x:Name="LblRoExeStatus" Text=""
                                             Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,0,0,10"/>

                                    <!-- Calibrate Button -->
                                    <Button x:Name="BtnCalibrate" Content="Calibrate Gamepad"
                                            Style="{StaticResource GhostButton}" Height="40" Padding="16,0"
                                            Margin="0,0,0,10" Click="BtnCalibrate_Click"/>

                                    <!-- Version and Path Info -->
                                    <TextBlock x:Name="LblVersion" Text=""
                                             Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="LblSettingsPath" Text=""
                                             Foreground="{StaticResource TextTertiary}" FontSize="9" FontFamily="Consolas" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel" Click="BtnCancel_Click"
                                Style="{StaticResource GhostButton}" Height="40" Padding="20,0" Margin="0,0,8,0"/>
                        <Button Content="Apply" Click="BtnApply_Click"
                                Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        </Window>