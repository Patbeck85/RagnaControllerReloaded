<Window x:Class="RagnaController.CommunityBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Community Profiles" Width="900" Height="700"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/UI2026DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Effect="{StaticResource GoldGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28" Background="{StaticResource AccentGold}" Effect="{StaticResource GoldGlow}" Margin="0,0,12,0" CornerRadius="2"/>
                        <TextBlock Text="COMMUNITY HUB" Style="{StaticResource BrandWordmark}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" Width="36" Height="36" Style="{StaticResource GhostButton}"/>
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="1" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,0,16,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GlassPanelCompact}" Padding="0" CornerRadius="{StaticResource RadiusMd}" Height="44">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="14,10" FontSize="15" VerticalContentAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnRefresh" Content="↻ Refresh" Click="BtnRefresh_Click" Style="{StaticResource GhostButton}" Width="110" Height="44" Margin="12,0,0,0" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Profile List & Overlays -->
            <Grid Grid.Row="2" Margin="24,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommunityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="18" CornerRadius="{StaticResource RadiusLg}" Margin="0,0,0,12" BorderBrush="{StaticResource BgBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                <Border Background="{StaticResource BgTertiary}" CornerRadius="{StaticResource RadiusSm}" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Class}" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentBlue}" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGold}" Margin="0,0,0,10" FontFamily="Segoe UI Variable, Segoe UI"/>
                                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontFamily="Segoe UI Variable, Segoe UI"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="↓ DOWNLOAD" Tag="{Binding ShareCode}" Click="BtnDownload_Click" Style="{StaticResource PrimaryButton}" Width="140" Height="44" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading State -->
                <Border x:Name="LoadingOverlay" Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusLg}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Fetching community profiles..." Foreground="{StaticResource AccentGold}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" Effect="{StaticResource GoldGlow}"/>
                    </StackPanel>
                </Border>

                <!-- Error State -->
                <Border x:Name="ErrorOverlay" Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource RadiusLg}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorText" Text="Failed to load." Foreground="{StaticResource Danger}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400" FontFamily="Segoe UI Variable, Segoe UI"/>
                        <Button Content="Retry" Click="BtnRefresh_Click" Style="{StaticResource GhostButton}" Width="110" Height="40" Margin="0,20,0,0" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>