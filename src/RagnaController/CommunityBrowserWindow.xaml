<Window x:Class="RagnaController.CommunityBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Community Profiles" Width="850" Height="650"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterOwner">
    
    <Border Background="#080A0F" BorderBrush="#2A3245" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="#2A3245" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐" Foreground="#E5B842" Margin="0,0,10,0" FontSize="16" Effect="{StaticResource NeonGlow}"/>
                        <TextBlock Text="COMMUNITY HUB" FontWeight="Black" FontSize="14" Foreground="#F0F4F8"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="#A1B0C5" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="1" Background="#121620" BorderBrush="#2A3245" BorderThickness="0,0,0,1" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#080A0F" BorderBrush="#2A3245" BorderThickness="1" CornerRadius="6" Height="36">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="#F0F4F8" BorderThickness="0" Padding="10,8" FontSize="14" VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnRefresh" Content="↻ Refresh" Click="BtnRefresh_Click" Style="{StaticResource ConsoleGhostBtn}" Width="100" Height="36" Margin="15,0,0,0"/>
                </Grid>
            </Border>

            <!-- Profile List & Overlays -->
            <Grid Grid.Row="2" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommunityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Black" Foreground="#F0F4F8"/>
                                                <Border Background="#1A2030" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Class}" FontSize="10" FontWeight="Bold" Foreground="#3A8EFF"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="11" FontWeight="Bold" Foreground="#E5B842" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#A1B0C5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="↓ DOWNLOAD" Tag="{Binding ShareCode}" Click="BtnDownload_Click" Style="{StaticResource ConsolePrimaryBtn}" Width="120" Height="40" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading State -->
                <Border x:Name="LoadingOverlay" Background="#DD080A0F" CornerRadius="8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Fetching community profiles..." Foreground="#E5B842" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Error State -->
                <Border x:Name="ErrorOverlay" Background="#DD080A0F" CornerRadius="8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorText" Text="Failed to load." Foreground="#FF3A52" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        <Button Content="Retry" Click="BtnRefresh_Click" Style="{StaticResource ConsoleGhostBtn}" Width="100" Height="36" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
