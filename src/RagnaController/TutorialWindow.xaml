<Window x:Class="RagnaController.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RagnaController.Core"
        Title="Tutorial" Width="760" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RagnaController;component/Resources/UI2026DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource GlassPanel}" CornerRadius="{StaticResource Radius2Xl}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource Gold}" BlurRadius="30" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,0,0,1" Margin="16,16,16,0" CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="20,12">
                    <TextBlock Text="RAGNACONTROLLER TUTORIALS" Style="{StaticResource BrandWordmark}" FontSize="15" VerticalAlignment="Center"/>
                    <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" Width="44" Height="44" Style="{StaticResource WindowControlButton}"/>
                </Grid>
            </Border>

            <!-- Content Area (The Slide) -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Text Content -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="TxtTitle" Text="{core:Loc Tut_1_Title}" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Black" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="34"/>
                    <TextBlock x:Name="TxtDesc" Text="{core:Loc Tut_1_Desc}" Foreground="{StaticResource TextSecondary}" FontSize="16" TextWrapping="Wrap" LineHeight="26"/>
                </StackPanel>

                <!-- Right: Media/GIF Placeholder -->
                <Border Grid.Column="1" Style="{StaticResource GlassPanel}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
                    <!-- MediaElement is used here to potentially load GIFs/MP4s in the future -->
                    <MediaElement x:Name="MediaPreview" LoadedBehavior="Play" UnloadedBehavior="Stop" Stretch="Uniform" Margin="8"/>
                </Border>
            </Grid>

            <!-- Footer (Navigation) -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanelCompact}" BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" Margin="16,0,16,16" CornerRadius="0,0,{StaticResource Radius2Xl},{StaticResource Radius2Xl}" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <!-- Progress Dots -->
                    <StackPanel x:Name="DotPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPrev" Content="{core:Loc Tut_Btn_Prev}" Click="BtnPrev_Click" Style="{StaticResource GhostButton}" Width="130" Height="44" Margin="0,0,12,0" IsEnabled="False"/>
                        <Button x:Name="BtnNext" Content="{core:Loc Tut_Btn_Next}" Click="BtnNext_Click" Style="{StaticResource PrimaryButton}" Width="160" Height="44"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>