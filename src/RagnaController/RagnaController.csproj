<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RagnaController</AssemblyName>
    <RootNamespace>RagnaController</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Authors>RagnaController Contributors</Authors>
    <Description>Hybrid Action Controller Layer for Ragnarok Online — Smart Cursor Edition</Description>
    <!-- Disable XAML compilation to avoid conflicts with manually written methods -->
    <XamlCompilation>Disabled</XamlCompilation>
    <!-- Enable Windows targeting to allow building on WSL -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Override NuGet package folder to avoid Windows-specific paths -->
    <NuGetPackageRoot>/home/patbe/.nuget/packages</NuGetPackageRoot>
    <!-- SourceLink for Stryker mutation testing -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/Patbeck85/RagnaControllerReloaded</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Localization namespace mapping for {core:Loc ...} bindings -->
    <XamlNamespaceMappings>
      <XamlNamespaceMapping>
        <Prefix>core</Prefix>
        <Assembly>RagnaController</Assembly>
        <Namespace>RagnaController.Locales</Namespace>
      </XamlNamespaceMapping>
    </XamlNamespaceMappings>
    <!-- Disable default compile items to avoid duplicates with Buildalyzer/generated files -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <!-- v1.7.0: System.Windows.Forms for Tray Icon support -->
    <PackageReference Include="System.Windows.Forms" Version="4.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Discord Rich Presence -->
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
    <!-- v1.7.2: Hexa.NET.SDL2 for native gamepad support (Xbox, DualShock 4, DualSense, Switch Pro) with Lightbar/Rumble -->
    <PackageReference Include="Hexa.NET.SDL2" Version="1.2.17" />
    <!-- SourceLink for Stryker mutation testing -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <!-- NU1701 Override: Suppress compatibility warning for System.Windows.Forms 4.0.0 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Disable fallback package folders to avoid Windows-specific paths in WSL -->
    <EnableFallbackPackageFolders>false</EnableFallbackPackageFolders>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico"            Condition="Exists('Assets\icon.ico')" />
