<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RagnaController</AssemblyName>
    <RootNamespace>RagnaController</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.5.1</Version>
    <Authors>RagnaController Contributors</Authors>
    <Description>Hybrid Action Controller Layer for Ragnarok Online — Smart Cursor Edition</Description>
    
    <XamlCompilation>Disabled</XamlCompilation>
    
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <NuGetPackageRoot>/home/patbe/.nuget/packages</NuGetPackageRoot>
    
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/Patbeck85/RagnaControllerReloaded</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <XamlNamespaceMappings>
      <XamlNamespaceMapping>
        <Prefix>core</Prefix>
        <Assembly>RagnaController</Assembly>
        <Namespace>RagnaController.Locales</Namespace>
      </XamlNamespaceMapping>
    </XamlNamespaceMappings>
    
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

